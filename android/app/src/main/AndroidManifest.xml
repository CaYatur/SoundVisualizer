<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Güncelleme denetimi ve web katmanı için. Uygulamanın kendi sayfaları
         ağa çıkmıyor: WebViewAssetLoader onları APK'dan veriyor. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PC bağlantısı: ağdaki bilgisayarların duyurusunu almak için yayın kilidi (yalnız
         "PC'ye Bağlan" sayfası açıkken tutulur). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Çalan parçanın uygulama adı: müzik uygulamaları medya tarayıcı hizmeti bildiriyor
         (Android 11+ paket görünürlüğü); ad okunamazsa paket adı yazılır. -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <!-- Ses kaynakları (PLAN D4): sistem sesi, mikrofon ve Visualizer yedeği
         hepsi RECORD_AUDIO istiyor; Visualizer çıkış karışımı (oturum 0) için
         ayrıca MODIFY_AUDIO_SETTINGS. Yakalama ön plan servisinde çalışır. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Uygulama içi çalar (PLAN 2.3): şarkı arka planda ve yüzen pencerede de çalar -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Serbest yüzen pencere (PLAN D3): "diğer uygulamaların üzerinde göster".
         Kullanıcı ayarlardan açar; açılmazsa yalnız sistem PiP'i kullanılır. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Kamera katmanı (Faz 4): izin yalnız kamera katmanı ilk açıldığında sorulur.
         Kamerası olmayan cihazlar da kurabilsin diye özellik zorunlu değil. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Yüzen pencerede kamera (media/CameraService.kt): arka planda kamera ön plan hizmetiyle -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SV">

        <!-- Döndürme ve boyut değişiminde Activity yeniden kurulmaz: WebView'in
             içindeki motor ve WebGL bağlamı korunur (PLAN 2.4). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Uygulama içi çalar. Medya oturumu (bildirim, kilit ekranı, kulaklık
             düğmeleri) için dışa açık olmak zorunda; bağlanan denetleyici serviste
             denetleniyor (yalnız sistemin güvendikleri: PlayerService.trustedOnly). -->
        <service
            android:name=".player.PlayerService"
            android:exported="true"
            tools:ignore="ExportedService"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service
            android:name=".audio.AudioService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <service
            android:name=".media.CameraService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Çalan parça (media/NowPlaying.kt): başka uygulamaların medya oturumlarını okumak
             için bildirim erişimi. Hizmet bildirimleri okumuyor; yalnız sistem bağlanabilir. -->
        <service
            android:name=".media.NowPlayingService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
