MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=0
[preset00]
fDecay=1
fGammaAdj=1
fVideoEchoAlpha=0
nWaveMode=0
fWaveAlpha=0
zoom=1
rot=0
warp=0
ob_size=0.5
ob_r=1
ob_g=1
ob_b=1
ob_a=0
ib_size=0
mv_a=0
fShader=0
per_frame_init_1=f0 = frame;
per_frame_1=ob_a = below(frame - f0, 2);
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz * 0.9;
warp_4=`}
