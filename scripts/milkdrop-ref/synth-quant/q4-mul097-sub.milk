MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=1
fGammaAdj=1
fVideoEchoAlpha=0
nWaveMode=0
fWaveAlpha=0
bTexWrap=1
zoom=1
rot=0
warp=0
ob_size=0
ib_size=0
mv_a=0
fShader=0
per_frame_init_1=f0 = frame;
per_frame_1=q1 = below(frame - f0, 3);
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz * 0.97 - 0.002 + q1;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_main, uv).xyz;
comp_4=`}
