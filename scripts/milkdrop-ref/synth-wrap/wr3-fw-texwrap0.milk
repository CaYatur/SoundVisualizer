MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=1
fGammaAdj=1
fVideoEchoAlpha=0
nWaveMode=0
fWaveAlpha=0
bTexWrap=0
zoom=1
rot=0
warp=0
ob_size=0
ib_size=0
mv_a=0
fShader=0
shapecode_0_enabled=1
shapecode_0_sides=24
shapecode_0_additive=0
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_x=0.100
shapecode_0_y=0.500
shapecode_0_rad=0.050
shapecode_0_ang=0.000
shapecode_0_r=1.000
shapecode_0_g=0.800
shapecode_0_b=0.200
shapecode_0_a=1.000
shapecode_0_r2=1.000
shapecode_0_g2=0.200
shapecode_0_b2=0.200
shapecode_0_a2=1.000
shapecode_0_border_a=0.000
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_fw_main, uv + float2(0.013, 0.004)).xyz * 0.995;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_fw_main, (uv - 0.5) * 1.6 + 0.5).xyz;
comp_4=`}
