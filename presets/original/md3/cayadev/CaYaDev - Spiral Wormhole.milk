MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=travel = 0;
per_frame_init_2=last = 0;
per_frame_init_3=rib = 1;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=spd = 0.35 + 0.8*min(bass_att, 2);
per_frame_5=travel = travel + spd/fps;
per_frame_6=beat = (bass > 1.3)*((time - last) > 0.35);
per_frame_7=last = if(beat, time, last);
per_frame_8=rib = if(beat, 0, min(1.5, rib + (0.6 + spd*0.5)/fps));
per_frame_9=q1 = travel;
per_frame_10=q2 = spd;
per_frame_11=q3 = 1.2 + 0.6*min(mid_att, 2);
per_frame_12=q4 = time*0.02 + mid_att*0.02;
per_frame_13=q5 = min(treb_att, 2);
per_frame_14=q6 = rib;
per_frame_15=q7 = 0.02*sin(time*0.17);
per_frame_16=q8 = 0.015*cos(time*0.13);
warp_1=`shader_body
warp_2=`{
warp_3=`  float2 c0 = float2(0.5 + q7, 0.5 + q8);
warp_4=`  float2 d = uv - c0;
warp_5=`  float3 prev = tex2D(sampler_main, c0 + d * (1.0 - 0.012 * q30 * (0.5 + q2))).xyz;
warp_6=`  ret = max(prev * pow(0.82, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_7=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 c0 = float2(0.5 + q7, 0.5 + q8);
comp_4=`  float2 p = (uv - c0) * aspect.xy;
comp_5=`  float r = length(p) + 1e-4;
comp_6=`  float a = atan2(p.y, p.x);
comp_7=`  float depth = -log(r);
comp_8=`  float tw = a / 6.28318 + depth * 0.12 * q3;
comp_9=`  float z = depth * 0.6 + q1 * 0.5;
comp_10=`  float n1 = tex3D(sampler_noisevol_hq, float3(cos(tw * 6.28318) * 0.5, sin(tw * 6.28318) * 0.5, z * 0.35)).x;
comp_11=`  float n2 = tex3D(sampler_noisevol_hq, float3(cos(tw * 12.566) * 0.8, sin(tw * 12.566) * 0.8, z * 0.7 + 0.3)).x;
comp_12=`  float stream = pow(saturate(1.0 - abs(frac(tw * 7.0 + n1 * 1.5) - 0.5) * 2.4), 4.0);
comp_13=`  float3 pa = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.25, 0.5) + q4 + depth * 0.05));
comp_14=`  float3 pb = 0.5 + 0.5 * cos(6.28318 * (float3(0.6, 0.75, 0.9) + q4));
comp_15=`  float3 wall = lerp(pa, pb, n2) * (0.15 + 0.85 * stream) * saturate(n1 * 1.6 - 0.2);
comp_16=`  float fog = saturate(r * 4.0);
comp_17=`  wall *= fog;
comp_18=`  float ribR = exp(-q6 * 2.0) ;
comp_19=`  float ribD = depth - (2.2 - q6 * 3.0);
comp_20=`  wall += pb * exp(-ribD * ribD * 30.0) * ribR * 0.8;
comp_21=`  float spark = step(0.996, tex2D(sampler_noise_lq, float2(tw * 40.0, z * 4.0)).x) * q5 * fog;
comp_22=`  float3 col = wall + spark * float3(1.0, 1.0, 1.0);
comp_23=`  col += float3(1.0, 0.95, 0.85) * exp(-r * 18.0) * (0.6 + 0.3 * q2);
comp_24=`  col += tex2D(sampler_main, uv).xyz * 0.5 + GetBlur2(uv) * 0.25;
comp_25=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.5;
comp_26=`  ret = 1.0 - exp(-col * 1.4);
comp_27=`}
