MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=last = 0;
per_frame_init_2=wave = 9;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.25)*((time - last) > 0.3);
per_frame_5=last = if(beat, time, last);
per_frame_6=wave = if(beat, 0, wave + 0.9/fps);
per_frame_7=q1 = time*0.12;
per_frame_8=q2 = wave;
per_frame_9=q3 = time*0.02 + mid_att*0.03;
per_frame_10=q4 = treb_att;
per_frame_11=q5 = cos(time*0.19);
per_frame_12=q6 = sin(time*0.15);
warp_1=`shader_body
warp_2=`{
warp_3=`  float2 p = (uv - 0.5) * aspect.xy;
warp_4=`  float ring = exp(-pow((length(p) - q2 * 0.6) * 18.0, 2.0)) * saturate(1.0 - q2);
warp_5=`  ret = max(tex2D(sampler_main, uv).xyz * pow(0.93, q30), float3(ring, 0, 0));
warp_6=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`shader_body
comp_3=`{
comp_4=`  float2 p = (uv - 0.5) * aspect.xy * 5.0;
comp_5=`  float2 cell = floor(p);
comp_6=`  float2 f = p - cell;
comp_7=`  float d1 = 9.0;
comp_8=`  float d2 = 9.0;
comp_9=`  float2 best = float2(0.0, 0.0);
comp_10=`  float4 hb = float4(0.0, 0.0, 0.0, 0.0);
comp_11=`  for (int j = -1; j <= 1; j++) {
comp_12=`    for (int i = -1; i <= 1; i++) {
comp_13=`      float2 o = float2(i, j);
comp_14=`      float4 h = tex2D(sampler_pw_noise_lq, ((cell + o) * float2(17.0, 29.0) + 0.5) / 256.0);
comp_15=`      float2 s = o + 0.5 + 0.35 * float2(sin(q1 + h.x * 6.28), cos(q1 * 0.8 + h.y * 6.28)) - f;
comp_16=`      float dd = dot(s, s);
comp_17=`      float closer = step(dd, d1);
comp_18=`      d2 = lerp(min(d2, dd), d1, closer);
comp_19=`      hb = lerp(hb, h, closer);
comp_20=`      best = lerp(best, s, closer);
comp_21=`      d1 = min(d1, dd);
comp_22=`    }
comp_23=`  }
comp_24=`  float edge = sqrt(d2) - sqrt(d1);
comp_25=`  float seam = 1.0 - smoothstep(0.0, 0.06, edge);
comp_26=`  float3 n = normalize(float3(cos(hb.z * 6.28), sin(hb.z * 6.28), 1.6));
comp_27=`  float3 L = normalize(float3(q5, q6, 0.9));
comp_28=`  float facet = saturate(dot(n, L));
comp_29=`  float3 base = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.33, 0.67) + hb.w * 0.75 + q3));
comp_30=`  base = saturate(lerp(dot(base, 0.333).xxx, base, 1.5)) * float3(0.8, 0.88, 1.1);
comp_31=`  float inner = 0.5 + 0.5 * cos(sqrt(d1) * 9.0 - hb.y * 6.28);
comp_32=`  float3 col = base * (0.05 + 0.75 * facet) * (0.75 + 0.35 * inner) + pow(facet, 14.0) * 0.55;
comp_33=`  col += (1.0 - base) * pow(saturate(1.0 - edge * 4.0), 3.0) * 0.12;
comp_34=`  col *= 1.0 - sqrt(d1) * 0.55;
comp_35=`  float glow = tex2D(sampler_main, uv).x;
comp_36=`  float3 disp = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.33, 0.67) + edge * 6.0 + q3 * 3.0));
comp_37=`  col += seam * (lerp(float3(0.8, 0.9, 1.0), disp, 0.6) * (0.3 + 0.5 * q4) + float3(1.0, 0.95, 0.9) * glow * 1.5);
comp_38=`  col += base * glow * 0.6;
comp_39=`  float2 v = uv - 0.5;
comp_40=`  col *= 1.0 - dot(v, v) * 0.8;
comp_41=`  ret = 1.0 - exp(-col * 1.5);
comp_42=`}
