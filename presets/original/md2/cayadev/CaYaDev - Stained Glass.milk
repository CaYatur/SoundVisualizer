MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=last = 0;
per_frame_init_2=ring = 9;
per_frame_init_3=turn = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.3)*((time - last) > 0.35);
per_frame_5=last = if(beat, time, last);
per_frame_6=ring = if(beat, 0, ring + (0.9 + 0.5*min(bass_att, 2))/fps);
per_frame_7=turn = turn + (0.02 + 0.04*min(mid_att, 2))/fps;
per_frame_8=q1 = ring;
per_frame_9=q2 = min(bass_att, 2);
per_frame_10=q3 = min(mid_att, 2);
per_frame_11=q4 = min(treb_att, 2);
per_frame_12=q5 = turn;
per_frame_13=q6 = time*0.11;
warp_1=`float2 hash2(float2 c)
warp_2=`{
warp_3=`  float3 p3 = frac(float3(c.x, c.y, c.x) * float3(0.1031, 0.1030, 0.0973));
warp_4=`  p3 += dot(p3, p3.yzx + 33.33);
warp_5=`  return frac((p3.xx + p3.yz) * p3.zy);
warp_6=`}
warp_7=`float2 cellPoint(float2 c)
warp_8=`{
warp_9=`  return 0.12 + 0.76 * hash2(c);
warp_10=`}
warp_11=`shader_body
warp_12=`{
warp_13=`  float2 p = (uv - 0.5) * aspect.xy;
warp_14=`  float2 g = p * 7.0;
warp_15=`  float2 base = floor(g);
warp_16=`  float d1 = 9.0;
warp_17=`  float d2 = 9.0;
warp_18=`  float2 best = float2(0.0, 0.0);
warp_19=`  for (int j = -1; j <= 1; j++)
warp_20=`  {
warp_21=`    for (int i = -1; i <= 1; i++)
warp_22=`    {
warp_23=`      float2 c = base + float2(i, j);
warp_24=`      float2 q = c + cellPoint(c) - g;
warp_25=`      float d = dot(q, q);
warp_26=`      if (d < d1) { d2 = d1; d1 = d; best = c; }
warp_27=`      else if (d < d2) { d2 = d; }
warp_28=`    }
warp_29=`  }
warp_30=`  float lead = smoothstep(0.02, 0.09, sqrt(d2) - sqrt(d1));
warp_31=`  float hs = hash2(best + 17.0).x;
warp_32=`  float3 pane = 0.5 + 0.5 * cos(6.28318 * (hs * 0.75 + q5 + float3(0.0, 0.33, 0.67)));
warp_33=`  pane = lerp(pane, pane * pane, 0.5);
warp_34=`  float hgt = saturate(0.5 - p.y / aspect.y);
warp_35=`  float lvl = lerp(lerp(q2, q3, smoothstep(0.2, 0.5, hgt)), q4, smoothstep(0.5, 0.8, hgt));
warp_36=`  float spec = saturate((lvl - 0.6) * 1.2 + (hs - 0.5) * 0.5);
warp_37=`  float2 sunp = float2(0.32 * sin(q6), 0.2 * cos(q6 * 1.3));
warp_38=`  float sun = exp(-dot(p - sunp, p - sunp) * 5.0);
warp_39=`  float shock = exp(-pow((length(p) - q1) * 9.0, 2.0));
warp_40=`  float lit = 0.16 + sun * 0.55 + spec * 0.75 + shock * 0.8;
warp_41=`  float3 col = pane * lit * lead;
warp_42=`  float3 old = tex2D(sampler_main, uv).xyz;
warp_43=`  ret = max(old * pow(0.86, q30) - 0.002 * max(q30, 1.0), col);
warp_44=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_4=`  float3 col = m * 1.15 + GetBlur1(uv) * 0.35 + GetBlur3(uv) * 0.3;
comp_5=`  float2 c = uv - 0.5;
comp_6=`  col *= 1.0 - dot(c, c) * 0.9;
comp_7=`  ret = 1.0 - exp(-col * 1.7);
comp_8=`}
