MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=last = 0;
per_frame_init_2=turn = 0;
per_frame_init_3=pulse = 3;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.3)*((time - last) > 0.4);
per_frame_5=last = if(beat, time, last);
per_frame_6=pulse = if(beat, -0.2, pulse + 1.1/fps);
per_frame_7=turn = turn + (0.5 + 0.9*min(mid_att, 2))/fps;
per_frame_8=q1 = turn;
per_frame_9=q2 = pulse;
per_frame_10=q3 = min(bass_att, 2);
per_frame_11=q4 = min(mid_att, 2);
per_frame_12=q5 = min(treb_att, 2);
per_frame_13=q6 = time*0.05;
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = tex2D(sampler_main, uv).xyz * pow(0.6, q30);
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 p = (uv - 0.5) * aspect.xy;
comp_4=`  float3 col = lerp(float3(0.01, 0.02, 0.05), float3(0.03, 0.015, 0.06), uv.x);
comp_5=`  for (int k = 0; k < 6; k++)
comp_6=`  {
comp_7=`    float fk = k;
comp_8=`    float2 c = float2(sin(fk * 2.4 + q6 * (1.0 + fk * 0.3)) * 0.7, cos(fk * 1.7 + q6 * 1.3) * 0.35);
comp_9=`    float d = length(p - c);
comp_10=`    float rad0 = 0.07 + 0.03 * frac(fk * 0.37);
comp_11=`    float3 tint = 0.5 + 0.5 * cos(6.28318 * (fk * 0.17 + float3(0.55, 0.7, 0.9)));
comp_12=`    col += tint * smoothstep(rad0, rad0 * 0.75, d) * 0.035;
comp_13=`  }
comp_14=`  float kx = 9.0;
comp_15=`  float amp = 0.17 + 0.01 * q3;
comp_16=`  float ph = p.x * kx + q1;
comp_17=`  float s = sin(ph);
comp_18=`  float cz = cos(ph);
comp_19=`  float y1 = s * amp;
comp_20=`  float y2 = -s * amp;
comp_21=`  float w1 = 0.011 + 0.008 * cz;
comp_22=`  float w2 = 0.011 - 0.008 * cz;
comp_23=`  float3 ca = float3(0.25, 0.75, 1.0);
comp_24=`  float3 cb = float3(1.0, 0.35, 0.75);
comp_25=`  float rp = ph / 3.14159 * 4.0;
comp_26=`  float rung = abs(frac(rp + 0.5) - 0.5) / (kx * 4.0 / 3.14159);
comp_27=`  float inside = step(abs(p.y), abs(y1));
comp_28=`  float along = saturate(uv.x);
comp_29=`  float lvl = along < 0.34 ? q3 : (along < 0.67 ? q4 : q5);
comp_30=`  float glow = 0.35 + 0.65 * saturate(lvl * 0.7);
comp_31=`  float side = step(0.0, p.y * s);
comp_32=`  float3 rc = lerp(cb, ca, side);
comp_33=`  col += rc * smoothstep(0.0045, 0.0015, rung) * inside * glow * (0.55 + 0.35 * abs(cz));
comp_34=`  float pd = exp(-pow((p.x / aspect.x + 0.5 - q2) * 9.0, 2.0));
comp_35=`  float e1 = smoothstep(w1, w1 * 0.45, abs(p.y - y1));
comp_36=`  float e2 = smoothstep(w2, w2 * 0.45, abs(p.y - y2));
comp_37=`  float3 s1 = ca * (0.55 + 0.45 * cz) + pd * 0.9;
comp_38=`  float3 s2 = cb * (0.55 - 0.45 * cz) + pd * 0.9;
comp_39=`  if (cz > 0.0)
comp_40=`  {
comp_41=`    col = lerp(col, s2, e2);
comp_42=`    col = lerp(col, s1, e1);
comp_43=`  }
comp_44=`  else
comp_45=`  {
comp_46=`    col = lerp(col, s1, e1);
comp_47=`    col = lerp(col, s2, e2);
comp_48=`  }
comp_49=`  col += ca * exp(-abs(p.y - y1) * 38.0) * 0.16 * (1.0 + pd * 2.0);
comp_50=`  col += cb * exp(-abs(p.y - y2) * 38.0) * 0.16 * (1.0 + pd * 2.0);
comp_51=`  col += tex2D(sampler_main, uv).xyz * 0.0;
comp_52=`  float2 v = uv - 0.5;
comp_53=`  col *= 1.0 - dot(v, v) * 0.8;
comp_54=`  ret = 1.0 - exp(-col * 1.7);
comp_55=`}
