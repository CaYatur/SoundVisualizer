MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
wavecode_0_enabled=1
wavecode_0_samples=480
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=0
wavecode_0_bAdditive=1
wavecode_0_scaling=1
wavecode_0_smoothing=0.5
wavecode_0_r=1
wavecode_0_g=1
wavecode_0_b=1
wavecode_0_a=0.9
wave_0_per_frame1=a = 0.6*min(1, q30)*(0.5 + 0.5*min(1.5, q3));
wave_0_per_frame2=t1 = time*0.07;
wave_0_per_point1=an = sample*6.28318 + time*0.02;
wave_0_per_point2=act = max(0, sin(an*3 + t1))*max(0, sin(an*5 - t1*1.3 + 1));
wave_0_per_point3=act = act*act;
wave_0_per_point4=rr = 0.235 + abs(value1)*0.08*act;
wave_0_per_point5=x = 0.5 + rr*cos(an);
wave_0_per_point6=y = 0.5 + rr*sin(an);
wave_0_per_point7=r = act;
wave_0_per_point8=g = 0;
wave_0_per_point9=b = 0;
per_frame_init_1=churn = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=churn = churn + (0.03 + 0.05*mid_att)/fps;
per_frame_5=zoom = 1 + (0.06 + 0.1*bass_att)/fps;
per_frame_6=q1 = churn;
per_frame_7=q2 = 0.6 + 0.7*bass_att;
per_frame_8=q3 = treb_att;
per_frame_9=q4 = time*0.01;
per_frame_10=q5 = time*0.035;
warp_1=`shader_body
warp_2=`{
warp_3=`  float2 p = (uv - 0.5) * aspect.xy;
warp_4=`  float2 swirl = float2(-p.y, p.x) * 0.002 * q30;
warp_5=`  float n = tex2D(sampler_noise_lq, uv * 3.0 + q4).x - 0.5;
warp_6=`  ret = tex2D(sampler_main, uv + swirl + n * 0.003).xyz * pow(0.96, q30);
warp_7=`}
comp_1=`float spot(float2 p, float lon, float lat, float R, float size)
comp_2=`{
comp_3=`  float3 c = float3(sin(lon) * cos(lat), sin(lat), cos(lon) * cos(lat));
comp_4=`  float d = length(p - c.xy * R) / (R * size);
comp_5=`  return (1.0 - smoothstep(0.35, 1.0, d)) * saturate(c.z * 4.0);
comp_6=`}
comp_7=`shader_body
comp_8=`{
comp_9=`  float2 p = (uv - 0.5) * aspect.xy;
comp_10=`  float r = length(p);
comp_11=`  float R = 0.24;
comp_12=`  float disc = saturate((R - r) * 600.0);
comp_13=`  float z = sqrt(saturate(1.0 - r * r / (R * R)));
comp_14=`  float2 sp = p / R;
comp_15=`  float2 sw = sp / (0.6 + 0.4 * z);
comp_16=`  float g1 = tex2D(sampler_noise_hq, sw * 1.1 + float2(q1, q1 * 0.7)).x;
comp_17=`  float g2 = tex2D(sampler_noise_hq, sw * 3.3 - float2(q1 * 1.3, q1 * 0.4)).x;
comp_18=`  float g3 = tex2D(sampler_noise_hq, sw * 0.35 + float2(q1 * 0.2, 0.3)).x;
comp_19=`  float gran = (g1 - 0.5) * 0.5 + (g2 - 0.5) * 0.7 + (g3 - 0.5) * 0.6;
comp_20=`  float lon = q5;
comp_21=`  float s1 = spot(p, lon, 0.32, R, 0.09 + 0.02 * g1);
comp_22=`  float s2 = spot(p, lon + 0.35, 0.27, R, 0.05 + 0.02 * g2);
comp_23=`  float s3 = spot(p, lon + 2.6, -0.22, R, 0.07 + 0.02 * g1);
comp_24=`  float pen = saturate(s1 + s2 + s3);
comp_25=`  float umbra = smoothstep(0.55, 0.95, pen);
comp_26=`  float limb = pow(z, 0.45);
comp_27=`  float3 surf = lerp(float3(0.75, 0.2, 0.03), float3(1.0, 0.86, 0.55), saturate(limb * 0.9 + gran * 0.35));
comp_28=`  surf *= (0.35 + 0.65 * limb) * (1.0 + gran * 0.25) * (1.0 - pen * 0.45) * (1.0 - umbra * 0.6);
comp_29=`  float cor = (exp(-max(r - R, 0.0) * (22.0 - q2 * 4.0)) + exp(-max(r - R, 0.0) * 7.0) * 0.1) * (1.0 - disc);
comp_30=`  float rays = tex2D(sampler_noise_hq, float2(atan2(p.y, p.x) * 0.159155 * 6.0, r * 0.8 - q4 * 3.0)).x;
comp_31=`  float3 corona = float3(1.0, 0.6, 0.25) * cor * (0.5 + 0.5 * rays) * q2 * 0.7;
comp_32=`  float3 prom = tex2D(sampler_main, uv).x * float3(1.0, 0.42, 0.12) * 1.8 + GetBlur1(uv).x * float3(1.0, 0.32, 0.08) * 1.2;
comp_33=`  prom *= (1.0 - disc * 0.8) * exp(-max(r - R, 0.0) * 14.0);
comp_34=`  float3 col = surf * disc + corona + prom;
comp_35=`  col += float3(0.004, 0.003, 0.008);
comp_36=`  ret = 1.0 - exp(-col * 1.6);
comp_37=`}
