per_frame_init_3=t0_0 = -10;
per_frame_init_4=x_0 = 0.5;
per_frame_init_5=h_0 = 0.5;
per_frame_init_6=t0_1 = -10;
per_frame_init_7=x_1 = 0.5;
per_frame_init_8=h_1 = 0.5;
per_frame_init_9=t0_2 = -10;
per_frame_init_10=x_2 = 0.5;
per_frame_init_11=h_2 = 0.5;
per_frame_init_12=t0_3 = -10;
per_frame_init_13=x_3 = 0.5;
per_frame_init_14=h_3 = 0.5;
per_frame_init_15=t0_4 = -10;
per_frame_init_16=x_4 = 0.5;
per_frame_init_17=h_4 = 0.5;
per_frame_init_18=t0_5 = -10;
per_frame_init_19=x_5 = 0.5;
per_frame_init_20=h_5 = 0.5;
per_frame_init_21=t0_6 = -10;
per_frame_init_22=x_6 = 0.5;
per_frame_init_23=h_6 = 0.5;
per_frame_init_24=t0_7 = -10;
per_frame_init_25=x_7 = 0.5;
per_frame_init_26=h_7 = 0.5;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.2)*((time - last) > 0.3);
per_frame_5=go = ((beat + ((time - last) > 1.5)) > 0);
per_frame_6=last = if(go, time, last);
per_frame_7=slot = if(go, (slot + 1)%8, slot);
per_frame_8=q1 = time*0.01;
per_frame_9=q2 = max(0, 1 - (time - last)*1.2);
per_frame_10=q3 = treb_att;
per_frame_11=t0_0 = if(go*equal(slot, 0), time, t0_0);
per_frame_12=x_0 = if(go*equal(slot, 0), 0.2 + 0.6*(rand(1000)*0.001), x_0);
per_frame_13=h_0 = if(go*equal(slot, 0), rand(1000)*0.001, h_0);
per_frame_14=q5 = t0_0;
per_frame_15=q6 = x_0;
per_frame_16=q7 = h_0;
per_frame_17=t0_1 = if(go*equal(slot, 1), time, t0_1);
per_frame_18=x_1 = if(go*equal(slot, 1), 0.2 + 0.6*(rand(1000)*0.001), x_1);
per_frame_19=h_1 = if(go*equal(slot, 1), rand(1000)*0.001, h_1);
per_frame_20=q9 = t0_1;
per_frame_21=q10 = x_1;
per_frame_22=q11 = h_1;
per_frame_23=t0_2 = if(go*equal(slot, 2), time, t0_2);
per_frame_24=x_2 = if(go*equal(slot, 2), 0.2 + 0.6*(rand(1000)*0.001), x_2);
per_frame_25=h_2 = if(go*equal(slot, 2), rand(1000)*0.001, h_2);
per_frame_26=q13 = t0_2;
per_frame_27=q14 = x_2;
per_frame_28=q15 = h_2;
per_frame_29=t0_3 = if(go*equal(slot, 3), time, t0_3);
per_frame_30=x_3 = if(go*equal(slot, 3), 0.2 + 0.6*(rand(1000)*0.001), x_3);
per_frame_31=h_3 = if(go*equal(slot, 3), rand(1000)*0.001, h_3);
per_frame_32=q17 = t0_3;
per_frame_33=q18 = x_3;
per_frame_34=q19 = h_3;
per_frame_35=t0_4 = if(go*equal(slot, 4), time, t0_4);
per_frame_36=x_4 = if(go*equal(slot, 4), 0.2 + 0.6*(rand(1000)*0.001), x_4);
per_frame_37=h_4 = if(go*equal(slot, 4), rand(1000)*0.001, h_4);
per_frame_38=q4 = t0_4;
per_frame_39=q8 = x_4;
per_frame_40=q12 = h_4;
per_frame_41=t0_5 = if(go*equal(slot, 5), time, t0_5);
per_frame_42=x_5 = if(go*equal(slot, 5), 0.2 + 0.6*(rand(1000)*0.001), x_5);
per_frame_43=h_5 = if(go*equal(slot, 5), rand(1000)*0.001, h_5);
per_frame_44=q16 = t0_5;
per_frame_45=q20 = x_5;
per_frame_46=q21 = h_5;
per_frame_47=t0_6 = if(go*equal(slot, 6), time, t0_6);
per_frame_48=x_6 = if(go*equal(slot, 6), 0.2 + 0.6*(rand(1000)*0.001), x_6);
per_frame_49=h_6 = if(go*equal(slot, 6), rand(1000)*0.001, h_6);
per_frame_50=q22 = t0_6;
per_frame_51=q23 = x_6;
per_frame_52=q24 = h_6;
per_frame_53=t0_7 = if(go*equal(slot, 7), time, t0_7);
per_frame_54=x_7 = if(go*equal(slot, 7), 0.2 + 0.6*(rand(1000)*0.001), x_7);
per_frame_55=h_7 = if(go*equal(slot, 7), rand(1000)*0.001, h_7);
per_frame_56=q25 = t0_7;
per_frame_57=q26 = x_7;
per_frame_58=q27 = h_7;
warp_1=`shader_body
warp_2=`{
warp_3=`  float2 fall = float2(0.0, -0.0006) * q30;
warp_4=`  ret = tex2D(sampler_main, uv + fall).xyz * pow(0.9, q30);
warp_5=`  ret = lerp(ret, GetBlur1(uv + fall) * pow(0.9, q30), 0.25 * min(1.0, q30));
warp_6=`  ret = max(ret - 0.002 * max(q30, 1.0), 0.0);
warp_7=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_4=`  float3 b2 = GetBlur2(uv);
comp_5=`  float3 b3 = GetBlur3(uv);
comp_6=`  float3 sky = lerp(float3(0.0, 0.01, 0.04), float3(0.03, 0.03, 0.08), uv.y);
comp_7=`  float smoke = tex2D(sampler_noise_hq, uv * float2(1.2, 0.8) + float2(q1, 0.0)).x;
comp_8=`  sky += lum(b3) * smoke * float3(0.6, 0.5, 0.5) * 0.9;
comp_9=`  float2 sp = uv * texsize.xy / 512.0;
comp_10=`  float4 st = tex2D(sampler_noise_lq, (floor((sp) * 256.0) + 0.5) / 256.0);
comp_11=`  float star = saturate((st.x * st.y - 0.98) * 50.0) * (0.6 + 0.4 * sin(time * 2.0 + st.z * 30.0)) * (0.5 + 0.5 * q3) * saturate(0.75 - uv.y);
comp_12=`  float3 col = sky + star * 0.7 + m * 2.0 + b2 * 1.2 + b3 * 0.7;
comp_13=`  float bx = floor(uv.x * 46.0);
comp_14=`  float bh = tex2D(sampler_noise_lq, (floor((float2(bx / 256.0, 0.5)) * 256.0) + 0.5) / 256.0).x;
comp_15=`  float roof = 0.86 - 0.11 * bh * bh;
comp_16=`  float city = step(roof, uv.y);
comp_17=`  float win = step(0.985, tex2D(sampler_noise_lq, (floor((float2(floor(uv.x * 260.0) / 256.0, floor(uv.y * 150.0) / 256.0)) * 256.0) + 0.5) / 256.0).x) * step(roof + 0.02, uv.y);
comp_18=`  float3 cityc = float3(0.01, 0.01, 0.02) + lum(b3) * float3(0.3, 0.25, 0.3) + win * float3(1.0, 0.75, 0.4) * 0.25;
comp_19=`  col = lerp(col, cityc, city);
comp_20=`  ret = 1.0 - exp(-col * 1.5);
comp_21=`}
