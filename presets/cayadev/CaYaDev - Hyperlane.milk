MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=travel = 0;
per_frame_init_2=last = 0;
per_frame_init_3=ring = 1;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=spd = 0.35 + 0.9*bass_att;
per_frame_5=travel = travel + spd/fps;
per_frame_6=zoom = 1.0 + spd*0.35/fps;
per_frame_7=beat = (bass > 1.3)*((time - last) > 0.3);
per_frame_8=last = if(beat, time, last);
per_frame_9=ring = if(beat, 0.0001, ring + (0.8 + spd*0.6)/fps);
per_frame_10=q1 = travel;
per_frame_11=q2 = spd;
per_frame_12=q3 = ring;
per_frame_13=q4 = treb_att;
per_frame_14=q5 = time*0.02;
per_frame_15=q6 = 0.03*sin(time*0.13);
per_frame_16=q7 = 0.02*cos(time*0.11);
warp_1=`sampler sampler_pw_noise_lq;
warp_2=`float stars(float2 p, float lanes, float rows, float shift, float keep)
warp_3=`{
warp_4=`  float r = length(p);
warp_5=`  float a = atan2(p.y, p.x) * 0.159155 + 0.5;
warp_6=`  float2 g = float2(a * lanes, (log(r) - shift) * rows);
warp_7=`  float2 cell = floor(g);
warp_8=`  float2 f = g - cell;
warp_9=`  float4 h = tex2D(sampler_pw_noise_lq, (cell + 0.5) / 256.0);
warp_10=`  float on = step(keep, h.y);
warp_11=`  float dx = (f.x - (0.2 + 0.6 * h.x)) * 6.28318 * r / lanes;
warp_12=`  float len = 0.05 + 0.25 * q2 * r;
warp_13=`  float dy = (f.y - (0.2 + 0.6 * h.z)) / rows;
warp_14=`  float w = exp(-dx * dx * 2.5e5);
warp_15=`  float s = saturate(1.0 - abs(dy + len * 0.5) / (len * 0.5 + 0.002));
warp_16=`  return on * w * s * saturate(r * 3.0 - 0.1) * (0.75 + h.w * 1.5);
warp_17=`}
warp_18=`shader_body
warp_19=`{
warp_20=`  float2 p = (uv - 0.5 - float2(q6, q7)) * aspect.xy;
warp_21=`  float s = stars(p, 140.0, 14.0, q1, 0.72);
warp_22=`  s += stars(p * 1.7, 260.0, 20.0, q1 * 1.3, 0.85) * 0.6 * saturate(q4 - 0.3);
warp_23=`  ret = tex2D(sampler_main, uv).xyz * pow(0.82, q30);
warp_24=`  ret += s * float3(0.85, 0.92, 1.0) * min(1.0, q30);
warp_25=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 c0 = 0.5 + float2(q6, q7);
comp_4=`  float2 p = (uv - c0) * aspect.xy;
comp_5=`  float r = length(p);
comp_6=`  float a = atan2(p.y, p.x);
comp_7=`  float2 dir = uv - c0;
comp_8=`  float ca = 0.006 * q2;
comp_9=`  float3 s;
comp_10=`  s.r = tex2D(sampler_main, uv - dir * ca).r;
comp_11=`  s.g = tex2D(sampler_main, uv).g;
comp_12=`  s.b = tex2D(sampler_main, uv + dir * ca).b;
comp_13=`  float2 tp = float2(a * 0.159155 * 2.0, log(r + 0.001) * 0.5 - q1 * 0.15);
comp_14=`  float n1 = tex3D(sampler_noisevol_hq, float3(cos(a) * 0.4, sin(a) * 0.4, tp.y + q5)).x;
comp_15=`  float n2 = tex3D(sampler_noisevol_hq, float3(cos(a) * 0.9, sin(a) * 0.9, tp.y * 2.0 + q5)).x;
comp_16=`  float3 neb = lerp(float3(0.25, 0.05, 0.45), float3(0.0, 0.35, 0.55), n2);
comp_17=`  neb *= pow(saturate(n1 * 1.4 - 0.25), 2.0) * saturate(r * 2.5) * 0.45;
comp_18=`  float3 col = neb + s * 1.3 + GetBlur1(uv) * 0.5 + GetBlur2(uv) * float3(0.5, 0.6, 1.0) * 0.4;
comp_19=`  col += float3(1.0, 0.8, 0.6) * 0.08 / (1.0 + r * 30.0);
comp_20=`  float ring = exp(-pow((r - q3 * 0.7) * 30.0, 2.0)) * saturate(1.0 - q3);
comp_21=`  col += float3(0.6, 0.8, 1.0) * ring * 0.5;
comp_22=`  ret = 1.0 - exp(-col * 1.4);
comp_23=`}
