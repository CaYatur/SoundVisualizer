wave_3_per_point28=g = if(equal(mk, 1), 1, g);
wave_3_per_point29=b = if(equal(mk, 1), 1, b);
wave_3_per_point30=a = if(equal(mk, 1), 1, a);
wave_3_per_point31=t1 = if(equal(mk, 1), q16, t1);
wave_3_per_point32=t2 = if(equal(mk, 1), q21, t2);
wave_3_per_point33=t3 = if(equal(mk, 1), q7, t3);
wave_3_per_point34=a = if(equal(mk, 1), min(1, q30), a);
wave_3_per_point35=s = if(equal(mk, 1), ms, s);
wave_3_per_point36=yy = if(equal(mk, 1), 0.12 + (0.485 - 0.12)*s, yy);
wave_3_per_point37=amp = if(equal(mk, 1), (0.004 + 0.022*t1 + 0.03*t2)*sin(3.14159*s), amp);
wave_3_per_point38=xx = if(equal(mk, 1), 0.710 + amp*sin(t3*44 + s*2*3.14159) + value1*0.004*sin(3.14159*s), xx);
wave_3_per_point39=x = if(equal(mk, 1), 0.5 + (xx - 0.5)/q31, x);
wave_3_per_point40=y = if(equal(mk, 1), 0.5 + (yy - 0.5)/q32, y);
wave_3_per_point41=lv = if(equal(mk, 1), 0.35 + 0.65*min(1, t1*1.5 + t2), lv);
wave_3_per_point42=r = if(equal(mk, 1), lv*0.775, r);
wave_3_per_point43=g = if(equal(mk, 1), lv*0.783, g);
wave_3_per_point44=b = if(equal(mk, 1), lv*0.100, b);
wave_3_per_point45=x = if(equal(mk, 2), 0.5, x);
wave_3_per_point46=y = if(equal(mk, 2), 0.5, y);
wave_3_per_point47=r = if(equal(mk, 2), 1, r);
wave_3_per_point48=g = if(equal(mk, 2), 1, g);
wave_3_per_point49=b = if(equal(mk, 2), 1, b);
wave_3_per_point50=a = if(equal(mk, 2), 1, a);
wave_3_per_point51=t1 = if(equal(mk, 2), q16, t1);
wave_3_per_point52=t2 = if(equal(mk, 2), q22, t2);
wave_3_per_point53=t3 = if(equal(mk, 2), q7, t3);
wave_3_per_point54=a = if(equal(mk, 2), min(1, q30), a);
wave_3_per_point55=s = if(equal(mk, 2), ms, s);
wave_3_per_point56=yy = if(equal(mk, 2), 0.12 + (0.440 - 0.12)*s, yy);
wave_3_per_point57=amp = if(equal(mk, 2), (0.004 + 0.022*t1 + 0.03*t2)*sin(3.14159*s), amp);
wave_3_per_point58=xx = if(equal(mk, 2), 0.754 + amp*sin(t3*47 + s*3*3.14159) + value1*0.004*sin(3.14159*s), xx);
wave_3_per_point59=x = if(equal(mk, 2), 0.5 + (xx - 0.5)/q31, x);
wave_3_per_point60=y = if(equal(mk, 2), 0.5 + (yy - 0.5)/q32, y);
wave_3_per_point61=lv = if(equal(mk, 2), 0.35 + 0.65*min(1, t1*1.5 + t2), lv);
wave_3_per_point62=r = if(equal(mk, 2), lv*0.940, r);
wave_3_per_point63=g = if(equal(mk, 2), lv*0.559, g);
wave_3_per_point64=b = if(equal(mk, 2), lv*0.165, b);
wave_3_per_point65=a = a*(mj > 0)*(mj < 121);
per_frame_init_1=last = 0;
per_frame_init_2=pk = 0;
per_frame_init_3=pl_0 = 0;
per_frame_init_4=pl_1 = 0;
per_frame_init_5=pl_2 = 0;
per_frame_init_6=pl_3 = 0;
per_frame_init_7=pl_4 = 0;
per_frame_init_8=pl_5 = 0;
per_frame_init_9=pl_6 = 0;
per_frame_init_10=pl_7 = 0;
per_frame_init_11=pl_8 = 0;
per_frame_init_12=pl_9 = 0;
per_frame_init_13=pl_10 = 0;
per_frame_init_14=pl_11 = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.3)*((time - last) > 0.3);
per_frame_5=last = if(beat, time, last);
per_frame_6=pk = if(beat, floor(rand(12)), pk);
per_frame_7=q1 = min(bass_att, 2);
per_frame_8=q2 = time*0.01;
per_frame_9=q3 = min(treb_att, 2);
per_frame_10=pl_0 = max(pl_0*pow(0.9, q30), beat*equal(pk, 0) + beat*0.3);
per_frame_11=q5 = max(0, min(1.5, bass) - 0.7);
per_frame_12=q6 = pl_0;
per_frame_13=q7 = time;
per_frame_14=pl_1 = max(pl_1*pow(0.9, q30), beat*equal(pk, 1) + beat*0.3);
per_frame_15=q9 = pl_1;
per_frame_16=pl_2 = max(pl_2*pow(0.9, q30), beat*equal(pk, 2) + beat*0.3);
per_frame_17=q11 = max(0, min(1.5, bass_att) - 0.7);
per_frame_18=q12 = pl_2;
per_frame_19=pl_3 = max(pl_3*pow(0.9, q30), beat*equal(pk, 3) + beat*0.3);
per_frame_20=q14 = max(0, min(1.5, mid) - 0.6);
per_frame_21=q15 = pl_3;
per_frame_22=pl_4 = max(pl_4*pow(0.9, q30), beat*equal(pk, 4) + beat*0.3);
per_frame_23=q4 = pl_4;
per_frame_24=pl_5 = max(pl_5*pow(0.9, q30), beat*equal(pk, 5) + beat*0.3);
per_frame_25=q8 = max(0, min(1.5, mid_att) - 0.6);
per_frame_26=q10 = pl_5;
per_frame_27=pl_6 = max(pl_6*pow(0.9, q30), beat*equal(pk, 6) + beat*0.3);
per_frame_28=q13 = pl_6;
per_frame_29=pl_7 = max(pl_7*pow(0.9, q30), beat*equal(pk, 7) + beat*0.3);
per_frame_30=q16 = max(0, min(1.5, treb) - 0.5);
per_frame_31=q17 = pl_7;
per_frame_32=pl_8 = max(pl_8*pow(0.9, q30), beat*equal(pk, 8) + beat*0.3);
per_frame_33=q18 = pl_8;
per_frame_34=pl_9 = max(pl_9*pow(0.9, q30), beat*equal(pk, 9) + beat*0.3);
per_frame_35=q19 = max(0, min(1.5, treb_att) - 0.5);
per_frame_36=q20 = pl_9;
per_frame_37=pl_10 = max(pl_10*pow(0.9, q30), beat*equal(pk, 10) + beat*0.3);
per_frame_38=q21 = pl_10;
per_frame_39=pl_11 = max(pl_11*pow(0.9, q30), beat*equal(pk, 11) + beat*0.3);
per_frame_40=q22 = pl_11;
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = max(tex2D(sampler_main, uv).xyz * pow(0.7, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 p = uv;
comp_4=`  float3 col = lerp(float3(0.05, 0.03, 0.06), float3(0.01, 0.01, 0.02), length(uv - float2(0.5, 0.45)) * 1.4);
comp_5=`  // harp frame (uv.y down): pillar on the left, curved neck on top, soundboard on the right
comp_6=`  float pillar = step(abs(p.x - 0.235), 0.012) * step(0.1, p.y) * step(p.y, 0.9);
comp_7=`  float tt = saturate((p.x - 0.235) / 0.52);
comp_8=`  float neckY = 0.12 + pow(tt, 1.2) * 0.42 - 0.035 * sin(tt * 3.14159);
comp_9=`  float neck = step(abs(p.y - (neckY - 0.03)), 0.018) * step(0.225, p.x) * step(p.x, 0.77);
comp_10=`  float board = step(abs(p.y - 0.88), 0.022) * step(0.22, p.x) * step(p.x, 0.78);
comp_11=`  float frm = saturate(pillar + neck + board);
comp_12=`  float3 wood = float3(0.18, 0.09, 0.04) * (0.6 + 0.4 * tex2D(sampler_noise_hq, p * float2(2.0, 30.0)).x);
comp_13=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_14=`  float3 glow = GetBlur1(uv) * 0.9 + GetBlur2(uv) * 0.6 + GetBlur3(uv) * 0.4;
comp_15=`  col += glow * 0.8;
comp_16=`  col = lerp(col, wood + glow * 0.4 + float3(0.25, 0.15, 0.05) * 0.2, frm);
comp_17=`  col += m * 1.5;
comp_18=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_19=`  ret = 1.0 - exp(-col * 1.5);
comp_20=`}
