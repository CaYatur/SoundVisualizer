wave_3_per_point94=star = if(equal(mk, 2), (nd < 0.05)*(0.7 + 0.3*sin(time*(1.3 + k*0.4) + k*7.7 + 11*3.1)), star);
wave_3_per_point95=br = if(equal(mk, 2), on*t2*(0.22 + 0.9*star), br);
wave_3_per_point96=x = if(equal(mk, 2), 0.5 + px/q31, x);
wave_3_per_point97=y = if(equal(mk, 2), 0.5 + (py - 0.5)/q32, y);
wave_3_per_point98=r = if(equal(mk, 2), 0.75*br, r);
wave_3_per_point99=g = if(equal(mk, 2), 0.85*br, g);
wave_3_per_point100=b = if(equal(mk, 2), 1.0*br, b);
wave_3_per_point101=a = a*(mj > 0)*(mj < 62);
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = max(tex2D(sampler_main, uv).xyz * pow(0.7, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  // the background sky turns with the figures, around the same pole above the screen
comp_4=`  float2 pr = (uv - float2(0.5, -0.25)) * aspect.xy;
comp_5=`  float cs = cos(q1);
comp_6=`  float sn = sin(q1);
comp_7=`  float2 su = float2(pr.x * cs - pr.y * sn, pr.x * sn + pr.y * cs) / aspect.xy + float2(0.5, -0.25);
comp_8=`  float3 col = lerp(float3(0.005, 0.008, 0.025), float3(0.02, 0.025, 0.06), uv.y);
comp_9=`  float band = exp(-pow((su.y - 0.35 - 0.25 * su.x), 2.0) * 40.0);
comp_10=`  float2 drift = float2(q3 * 1.5, 0.0);
comp_11=`  float neb = tex3D(sampler_noisevol_hq, float3(su * float2(2.4, 1.4) + drift, q3)).x * 0.6 + tex3D(sampler_noisevol_hq, float3(su * float2(6.0, 3.4) + drift * 2.0, q3 + 0.3)).x * 0.4;
comp_12=`  col += float3(0.11, 0.09, 0.16) * band * neb;
comp_13=`  float4 st = tex2D(sampler_noise_lq, (floor((su * texsize.xy / 512.0) * 256.0) + 0.5) / 256.0);
comp_14=`  float tw = 0.45 + 0.55 * sin(time * (1.6 + st.z * 4.0) + st.w * 30.0);
comp_15=`  col += saturate((st.x * st.y - 0.96) * 40.0) * tw * (0.45 + 0.25 * q2) * float3(0.85, 0.9, 1.0);
comp_16=`  // a shooting star every 1.6 s from a hashed point in the upper sky, gone after 1.1 s
comp_17=`  float mt = time / 1.6;
comp_18=`  float mk = floor(mt);
comp_19=`  float mf = mt - mk;
comp_20=`  float2 ms = float2(0.15 + 0.7 * frac(sin(mk * 12.9898) * 43758.5), 0.05 + 0.3 * frac(sin(mk * 78.233) * 43758.5));
comp_21=`  float2 md = normalize(float2((0.8 + 0.4 * frac(sin(mk * 3.1) * 917.3)) * (frac(sin(mk * 7.7) * 331.1) > 0.5 ? 1.0 : -1.0), 0.45));
comp_22=`  float2 rel = (uv - ms) * aspect.xy - md * mf * 1.1;
comp_23=`  float back = -dot(rel, md);
comp_24=`  float perp = length(rel + back * md);
comp_25=`  float meteor = exp(-perp * 450.0) * step(0.0, back) * exp(-back * 7.0) * saturate(1.0 - mf / 0.7);
comp_26=`  col += float3(0.9, 0.95, 1.0) * meteor * 1.8;
comp_27=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_28=`  col += m * 1.4 + GetBlur1(uv) * float3(0.6, 0.7, 1.0) * 0.8 + GetBlur2(uv) * float3(0.4, 0.5, 0.9) * 0.4;
comp_29=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_30=`  ret = 1.0 - exp(-col * 1.5);
comp_31=`}

