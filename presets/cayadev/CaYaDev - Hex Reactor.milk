MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=last = 0;
per_frame_init_2=ring = 9;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.3)*((time - last) > 0.3);
per_frame_5=last = if(beat, time, last);
per_frame_6=ring = if(beat, 0, ring + (6 + 6*min(bass_att, 2))/fps);
per_frame_7=q1 = ring;
per_frame_8=q2 = min(bass_att, 2);
per_frame_9=q3 = min(mid_att, 2);
per_frame_10=q4 = min(treb_att, 2);
per_frame_11=q5 = time*0.02 + mid_att*0.02;
per_frame_12=q6 = time*0.4;
warp_1=`float hexDist(float2 p)
warp_2=`{
warp_3=`  p = abs(p);
warp_4=`  return max(dot(p, normalize(float2(1.0, 1.7320508))), p.x);
warp_5=`}
warp_6=`shader_body
warp_7=`{
warp_8=`  float2 p = (uv - 0.5) * aspect.xy * 22.0;
warp_9=`  float2 r = float2(1.0, 1.7320508);
warp_10=`  float2 h = r * 0.5;
warp_11=`  float2 a = p - r * floor(p / r + 0.5);
warp_12=`  float2 b = p - h - r * floor((p - h) / r + 0.5);
warp_13=`  float2 g = dot(a, a) < dot(b, b) ? a : b;
warp_14=`  float2 id = p - g;
warp_15=`  float rings = length(id) * 0.62;
warp_16=`  float edge = hexDist(g);
warp_17=`  float cell = smoothstep(0.5, 0.42, edge);
warp_18=`  float bev = smoothstep(0.5, 0.36, edge) - smoothstep(0.36, 0.2, edge);
warp_19=`  float band = saturate(rings / 7.0);
warp_20=`  float lvl = band < 0.33 ? q2 : (band < 0.66 ? q3 : q4);
warp_21=`  float spec = saturate((lvl - 0.55 - band * 0.6) * 1.5) * step(rings, 7.5);
warp_22=`  float shock = exp(-pow(rings - q1, 2.0) * 1.5);
warp_23=`  float an = atan2(id.y, id.x);
warp_24=`  float sweep = pow(saturate(cos(an - q6)), 30.0);
warp_25=`  float fire = saturate(spec * 0.7 + shock * 0.6 + sweep * 0.45);
warp_26=`  float3 pa = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.33, 0.67) * 0.5 + q5 + band * 0.4));
warp_27=`  float3 lit = pa * fire * (cell * 0.6 + bev * 0.9) + float3(0.05, 0.09, 0.16) * bev;
warp_28=`  float3 old = tex2D(sampler_main, uv).xyz;
warp_29=`  ret = max(old * pow(0.8, q30) - 0.002 * max(q30, 1.0), lit);
warp_30=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 p = (uv - 0.5) * aspect.xy;
comp_4=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_5=`  float3 col = float3(0.01, 0.012, 0.02) + m * 1.05 + GetBlur1(uv) * 0.5 + GetBlur2(uv) * 0.35;
comp_6=`  col += float3(1.0, 0.9, 0.8) * exp(-length(p) * 30.0) * (0.3 + 0.3 * q2);
comp_7=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_8=`  ret = 1.0 - exp(-col * 1.5);
comp_9=`}
