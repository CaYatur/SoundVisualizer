MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=pan = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=pan = pan + (0.01 + 0.01*mid_att)/fps;
per_frame_5=q1 = pan;
per_frame_6=q2 = 0.35 + 0.9*bass_att;
per_frame_7=q3 = 0.25*mid_att;
per_frame_8=q4 = cos(time*0.21);
per_frame_9=q5 = sin(time*0.17);
per_frame_10=q6 = treb_att;
warp_1=`float crack(float2 p)
warp_2=`{
warp_3=`  float n = tex2D(sampler_noise_hq, p).x;
warp_4=`  return pow(saturate(1.0 - abs(n * 2.0 - 1.0)), 30.0);
warp_5=`}
warp_6=`shader_body
warp_7=`{
warp_8=`  float2 p = (uv - 0.5) * aspect.xy + float2(q1, q1 * 0.6);
warp_9=`  float c1 = crack(p * 0.9);
warp_10=`  float c2 = crack(p * 2.1 + 0.37) * saturate(q3 * 1.6 - 0.2);
warp_11=`  float c = saturate(c1 + c2 * 0.6);
warp_12=`  ret = tex2D(sampler_main, uv).xyz * pow(0.9, q30);
warp_13=`  ret = max(ret, float3(c, c * 0.8, 0) * q2 * 0.45);
warp_14=`}
comp_1=`float crack(float2 p)
comp_2=`{
comp_3=`  float n = tex2D(sampler_noise_hq, p).x;
comp_4=`  return pow(saturate(1.0 - abs(n * 2.0 - 1.0)), 30.0);
comp_5=`}
comp_6=`shader_body
comp_7=`{
comp_8=`  float2 p = (uv - 0.5) * aspect.xy + float2(q1, q1 * 0.6);
comp_9=`  float g1 = tex2D(sampler_noise_hq, p * 0.35).x;
comp_10=`  float g2 = tex2D(sampler_noise_hq, p * 1.3 + 0.5).x;
comp_11=`  float h = g1 * 0.7 + g2 * 0.3;
comp_12=`  float e = 0.004;
comp_13=`  float hx = tex2D(sampler_noise_hq, (p + float2(e, 0)) * 0.35).x - tex2D(sampler_noise_hq, (p - float2(e, 0)) * 0.35).x;
comp_14=`  float hy = tex2D(sampler_noise_hq, (p + float2(0, e)) * 0.35).x - tex2D(sampler_noise_hq, (p - float2(0, e)) * 0.35).x;
comp_15=`  float3 n = normalize(float3(hx, hy, 0.02));
comp_16=`  float3 L = normalize(float3(q4, q5, 0.9));
comp_17=`  float spec = pow(saturate(dot(reflect(-L, n), float3(0, 0, 1))), 40.0);
comp_18=`  float3 glaze = lerp(float3(0.01, 0.015, 0.04), float3(0.05, 0.1, 0.16), h);
comp_19=`  glaze = lerp(glaze, float3(0.12, 0.05, 0.1), saturate(g2 - 0.6) * 1.5);
comp_20=`  glaze += spec * float3(0.6, 0.7, 0.8) * 0.5;
comp_21=`  float c1 = crack(p * 0.9);
comp_22=`  float c2 = crack(p * 2.1 + 0.37) * saturate(q3 * 1.6 - 0.2);
comp_23=`  float c = saturate(c1 + c2 * 0.6);
comp_24=`  float3 gold = float3(1.0, 0.72, 0.28);
comp_25=`  float gspec = pow(saturate(dot(reflect(-L, normalize(float3(hy, -hx, 0.05))), float3(0, 0, 1))), 8.0);
comp_26=`  float3 col = lerp(glaze, gold * (0.55 + 0.8 * gspec + 0.15 * q6), saturate(c * 1.6));
comp_27=`  col += float3(1.0, 0.6, 0.2) * (GetBlur1(uv).x * 0.35 + GetBlur2(uv).x * 0.4) * (0.35 + 0.3 * q2);
comp_28=`  float2 v = uv - 0.5;
comp_29=`  col *= 1.0 - dot(v, v) * 0.9;
comp_30=`  ret = 1.0 - exp(-col * 1.6);
comp_31=`}
