per_frame_init_10=ph9 = 0;
per_frame_init_11=ph10 = 0;
per_frame_init_12=ph11 = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=q1 = time*0.03;
per_frame_5=q2 = 0.6 + 0.5*bass_att;
per_frame_6=q3 = treb_att;
per_frame_7=q4 = time*0.004;
per_frame_8=ph0 = ph0 + 0.9000*(0.6 + 0.4*mid_att)/fps;
per_frame_9=q5 = ph0 + 0.0000;
per_frame_10=ph1 = ph1 + 0.6278*(0.6 + 0.4*mid_att)/fps;
per_frame_11=q6 = ph1 + 2.4000;
per_frame_12=ph2 = ph2 + 0.4761*(0.6 + 0.4*mid_att)/fps;
per_frame_13=q7 = ph2 + 4.7999;
per_frame_14=ph3 = ph3 + 0.3803*(0.6 + 0.4*mid_att)/fps;
per_frame_15=q8 = ph3 + 7.1999;
per_frame_16=ph4 = ph4 + 0.3148*(0.6 + 0.4*mid_att)/fps;
per_frame_17=q9 = ph4 + 9.5998;
per_frame_18=ph5 = ph5 + 0.2673*(0.6 + 0.4*mid_att)/fps;
per_frame_19=q10 = ph5 + 11.9998;
per_frame_20=ph6 = ph6 + 0.2315*(0.6 + 0.4*mid_att)/fps;
per_frame_21=q11 = ph6 + 14.3998;
per_frame_22=ph7 = ph7 + 0.2036*(0.6 + 0.4*mid_att)/fps;
