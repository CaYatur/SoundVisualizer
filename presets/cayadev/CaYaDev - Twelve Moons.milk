warp_1=`shader_body
warp_2=`{
warp_3=`  float k = pow(0.94, q30);
warp_4=`  ret = lerp(tex2D(sampler_main, uv).xyz, GetBlur1(uv), 0.36 * min(1.0, q30)) * k;
warp_5=`  ret = ret - 0.002 * max(q30, 1.0);
warp_6=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 p = (uv - 0.5) * aspect.xy;
comp_4=`  float R = 0.12;
comp_5=`  float r = length(p);
comp_6=`  float3 trails = tex2D(sampler_main, uv).xyz;
comp_7=`  float3 tglow = GetBlur1(uv) * 0.8 + GetBlur2(uv) * 0.6;
comp_8=`  float2 sp = uv * texsize.xy / 512.0;
comp_9=`  float4 st = tex2D(sampler_noise_lq, (floor((sp) * 256.0) + 0.5) / 256.0);
comp_10=`  float tw = 0.55 + 0.45 * sin(time * (1.3 + st.z * 4.0) + st.w * 30.0);
comp_11=`  float star = saturate((st.x * st.y - 0.975) * 45.0) * tw * (0.5 + 0.5 * q3);
comp_12=`  float3 bg = lerp(float3(0.01, 0.01, 0.03), float3(0.04, 0.02, 0.06), saturate(1.0 - r * 1.5));
comp_13=`  bg += tex2D(sampler_noise_hq, uv * 0.6 + q4).x * float3(0.03, 0.015, 0.05);
comp_14=`  float3 col = bg + star * float3(0.85, 0.9, 1.0);
comp_15=`  float2 e = p / float2(1.0, 0.32);
comp_16=`  float er = length(e);
comp_17=`  float band = saturate((er - 0.16) * 200.0) * saturate((0.28 - er) * 200.0);
comp_18=`  float gaps = tex2D(sampler_noise_hq, float2(er * 2.2, 0.5)).x;
comp_19=`  float3 ringc = lerp(float3(0.75, 0.62, 0.45), float3(0.95, 0.88, 0.75), gaps) * (0.35 + 0.65 * smoothstep(0.3, 0.7, gaps));
comp_20=`  float ringa = band * 0.85;
comp_21=`  float behind = step(p.y, 0.0);
comp_22=`  col = lerp(col, ringc * 0.8, ringa * behind);
comp_23=`  float pm = saturate((R - r) * 400.0);
comp_24=`  float z = sqrt(saturate(1.0 - (r * r) / (R * R)));
comp_25=`  float3 n = float3(p / R, z);
comp_26=`  float lat = n.y;
comp_27=`  float lon = atan2(n.x, z) * 0.3 + q1;
comp_28=`  float bands = tex2D(sampler_noise_hq, float2(lon * 0.5, lat * 0.6 + 0.3)).x;
comp_29=`  float bands2 = tex2D(sampler_noise_hq, float2(lon * 1.5, lat * 2.0 + 0.7)).x;
comp_30=`  float stripe = sin(lat * 11.0 + bands * 2.5 + bands2 * 0.8) * 0.5 + 0.5;
comp_31=`  float3 gas = lerp(float3(0.7, 0.38, 0.2), float3(0.98, 0.88, 0.7), stripe);
comp_32=`  gas = lerp(gas, float3(0.85, 0.55, 0.35), saturate(sin(lat * 3.0 + 1.0)) * 0.4);
comp_33=`  float storm = exp(-dot(n.xy - float2(0.35, 0.25), n.xy - float2(0.35, 0.25)) * 60.0);
comp_34=`  gas = lerp(gas, float3(0.8, 0.35, 0.25), storm * 0.7);
comp_35=`  float3 L = normalize(float3(-0.6, -0.35, 0.7));
comp_36=`  float diff = saturate(dot(n, L));
comp_37=`  float3 planet = gas * (0.05 + 1.05 * pow(diff, 0.8));
comp_38=`  planet += float3(0.3, 0.55, 1.0) * pow(1.0 - z, 3.0) * 0.6 * q2;
comp_39=`  col = lerp(col, planet, pm);
comp_40=`  col = lerp(col, ringc, ringa * (1.0 - behind));
comp_41=`  float atm = exp(-pow((r - R) * 60.0, 2.0)) * (1.0 - pm);
comp_42=`  col += float3(0.35, 0.6, 1.0) * atm * 0.5 * q2;
comp_43=`  float hide = 1.0 - pm * behind;
comp_44=`  col += (trails * 1.2 + tglow) * hide;
comp_45=`  ret = 1.0 - exp(-col * 1.5);
comp_46=`}
