MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=travel = 0;
per_frame_init_2=last = 0;
per_frame_init_3=flare = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=travel = travel + (0.8 + 1.6*min(bass_att, 2))/fps;
per_frame_5=beat = (bass > 1.3)*((time - last) > 0.3);
per_frame_6=last = if(beat, time, last);
per_frame_7=flare = max(flare*pow(0.85, q30), beat);
per_frame_8=q1 = travel;
per_frame_9=q2 = flare;
per_frame_10=q3 = time*0.02 + mid_att*0.03;
per_frame_11=q4 = min(treb_att, 2);
warp_1=`float archAt(float2 p, float z)
warp_2=`{
warp_3=`  // arch in world units: pillars at x = +-1, height 1.6, top half-circle radius 1
warp_4=`  float2 w = p * z;
warp_5=`  float wy = -w.y;
warp_6=`  float pill = abs(abs(w.x) - 1.0);
warp_7=`  float d1 = pill + max(0.0, -0.9 - wy) * 10.0 + max(0.0, wy - 0.6) * 10.0;
warp_8=`  float2 c = float2(w.x, wy - 0.6);
warp_9=`  float d2 = abs(length(c) - 1.0) + max(0.0, -c.y) * 10.0;
warp_10=`  float d = min(d1, d2);
warp_11=`  return d / z;
warp_12=`}
warp_13=`float3 scene(float2 p)
warp_14=`{
warp_15=`  float3 col = float3(0.0, 0.0, 0.0);
warp_16=`  float sp = 2.0;
warp_17=`  float fz = frac(q1 / sp);
warp_18=`  for (int i = 0; i < 9; i++) {
warp_19=`    float z = (i + 1.0 - fz) * sp * 0.5 + 0.2;
warp_20=`    float d = archAt(p, z);
warp_21=`    float k = floor(q1 / sp) + i;
warp_22=`    float3 pal = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.33, 0.67) + k * 0.13 + q3));
warp_23=`    float near = i < 1 ? q2 : 0.0;
warp_24=`    float glow = exp(-d * 350.0) * 1.2 + exp(-d * 40.0) * 0.25;
warp_25=`    col += pal * glow * exp(-z * 0.25) * (1.0 + near * 1.5);
warp_26=`  }
warp_27=`  return col;
warp_28=`}
warp_29=`shader_body
warp_30=`{
warp_31=`  float2 p = (uv - 0.5) * aspect.xy * 2.0;
warp_32=`  float3 col = float3(0.01, 0.005, 0.03) + float3(0.06, 0.02, 0.1) * saturate(1.0 + p.y * 2.0);
warp_33=`  float floorY = 0.18;
warp_34=`  if (p.y < floorY) {
warp_35=`    col += scene(p);
warp_36=`  } else {
warp_37=`    float dy = p.y - floorY;
warp_38=`    float2 rp = float2(p.x + sin(dy * 60.0 + q1 * 2.0) * 0.004, floorY - dy);
warp_39=`    col += scene(rp) * 0.45 * (1.0 - saturate(dy * 1.2));
warp_40=`    float zf = 0.3 / dy;
warp_41=`    float gx = abs(frac(p.x * zf * 0.6) - 0.5);
warp_42=`    float gz = abs(frac(zf * 0.5 + q1 * 0.5) - 0.5);
warp_43=`    float grid = (exp(-gx * 60.0 / zf) + exp(-gz * 60.0 / zf)) * saturate(dy * 4.0);
warp_44=`    col += float3(0.4, 0.2, 0.8) * grid * 0.25;
warp_45=`    float sp = step(0.997, tex2D(sampler_noise_lq, float2(p.x * zf * 2.0, zf + q1)).x) * q4;
warp_46=`    col += sp * 0.5;
warp_47=`  }
warp_48=`  // a short motion streak: the previous frame, pulled slightly outward
warp_49=`  float2 d = uv - 0.5;
warp_50=`  float3 prev = tex2D(sampler_main, 0.5 + d * (1.0 - 0.01 * q30)).xyz;
warp_51=`  ret = max(prev * pow(0.7, q30) - 0.002 * max(q30, 1.0), col);
warp_52=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 col = tex2D(sampler_main, uv).xyz + GetBlur1(uv) * 0.6 + GetBlur2(uv) * 0.35;
comp_4=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.5;
comp_5=`  ret = 1.0 - exp(-col * 1.5);
comp_6=`}
