per_frame_175=mh = mon*(floor(mv/mp) - 2*floor(mv/(2*mp)));
per_frame_176=s0 = s0 - mh*equal(mk, 0)*mp;
per_frame_177=s1 = s1 - mh*equal(mk, 1)*mp;
per_frame_178=s2 = s2 - mh*equal(mk, 2)*mp;
per_frame_179=s3 = s3 - mh*equal(mk, 3)*mp;
