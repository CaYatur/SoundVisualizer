per_frame_68=s1 = s1 - gh*equal(gk, 1)*gp;
per_frame_69=s2 = s2 - gh*equal(gk, 2)*gp;
per_frame_70=s3 = s3 - gh*equal(gk, 3)*gp;
per_frame_71=hx = if(gh, bx, hx);
per_frame_72=hy = if(gh, by, hy);
per_frame_73=ht = if(gh, time, ht);
per_frame_74=by = if(gh, -1, by);
