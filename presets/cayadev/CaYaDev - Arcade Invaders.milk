per_frame_106=n9 = n9 - kil*equal(ac, 9);
per_frame_107=n10 = n10 - kil*equal(ac, 10);
per_frame_108=alive = alive - kil;
per_frame_109=score = score + kil*if(ar < 1, 30, if(ar < 3, 20, 10));
per_frame_110=ex = if(kil, basex + ac*16 + 4, ex);
per_frame_111=ey = if(kil, basey + ar*14 + 4, ey);
per_frame_112=et = if(kil, time, et);
