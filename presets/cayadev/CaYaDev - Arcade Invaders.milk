per_frame_126=hy = if(gh, by, hy);
per_frame_127=ht = if(gh, time, ht);
per_frame_128=by = if(gh, -1, by);
per_frame_129=uh = (by >= 0)*(ux > -20)*(abs(bx - ux) < 7)*(by < 12)*(by > 4);
per_frame_130=score = score + uh*100;
per_frame_131=ex = if(uh, ux, ex);
per_frame_132=ey = if(uh, 8, ey);
per_frame_133=et = if(uh, time, et);
per_frame_134=ux = if(uh, -40, ux);
per_frame_135=nu = if(uh, time + 14 + rand(10), nu);
per_frame_136=by = if(uh + (by < 2)*(by >= 0), -1, by);
per_frame_137=// alien bombs from the lowest alien in a column
per_frame_138=drp = (my < 0)*(time > nb);
per_frame_139=bc = floor(rand(11));
per_frame_140=bc = if((equal(bc, 0)*n0 + equal(bc, 1)*n1 + equal(bc, 2)*n2 + equal(bc, 3)*n3 + equal(bc, 4)*n4 + equal(bc, 5)*n5 + equal(bc, 6)*n6 + equal(bc, 7)*n7 + equal(bc, 8)*n8 + equal(bc, 9)*n9 + equal(bc, 10)*n10) > 0, bc, floor(rand(11)));
per_frame_141=bc = if((equal(bc, 0)*n0 + equal(bc, 1)*n1 + equal(bc, 2)*n2 + equal(bc, 3)*n3 + equal(bc, 4)*n4 + equal(bc, 5)*n5 + equal(bc, 6)*n6 + equal(bc, 7)*n7 + equal(bc, 8)*n8 + equal(bc, 9)*n9 + equal(bc, 10)*n10) > 0, bc, floor(rand(11)));
per_frame_142=bc = if((equal(bc, 0)*n0 + equal(bc, 1)*n1 + equal(bc, 2)*n2 + equal(bc, 3)*n3 + equal(bc, 4)*n4 + equal(bc, 5)*n5 + equal(bc, 6)*n6 + equal(bc, 7)*n7 + equal(bc, 8)*n8 + equal(bc, 9)*n9 + equal(bc, 10)*n10) > 0, bc, floor(rand(11)));
per_frame_143=r4w = floor((4*11 + bc)/22);
per_frame_144=r4p = pow(2, (4*11 + bc) - r4w*22);
per_frame_145=r4v = if(equal(r4w, 0), w0, if(equal(r4w, 1), w1, w2));
per_frame_146=r4a = floor(r4v/r4p) - 2*floor(r4v/(2*r4p));
per_frame_147=r3w = floor((3*11 + bc)/22);
per_frame_148=r3p = pow(2, (3*11 + bc) - r3w*22);
per_frame_149=r3v = if(equal(r3w, 0), w0, if(equal(r3w, 1), w1, w2));
per_frame_150=r3a = floor(r3v/r3p) - 2*floor(r3v/(2*r3p));
per_frame_151=r2w = floor((2*11 + bc)/22);
per_frame_152=r2p = pow(2, (2*11 + bc) - r2w*22);
per_frame_153=r2v = if(equal(r2w, 0), w0, if(equal(r2w, 1), w1, w2));
