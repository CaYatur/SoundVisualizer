per_frame_init_25=wst = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=dt = min(1/max(fps, 1), 0.07);
per_frame_5=// fewer aliens and later waves march faster
per_frame_6=fast = 1 + (55 - alive)/16 + (wave - 1)*0.25;
per_frame_7=acc = acc + (1.5 + 2.5*min(bass_att, 2))*fast*dt;
per_frame_8=st = (acc > 1);
per_frame_9=stp = stp + st;
per_frame_10=acc = acc - st;
per_frame_11=tt = stp - 40*floor(stp/40);
per_frame_12=offx = if(tt < 20, tt*2, (40 - tt)*2);
per_frame_13=// the fleet keeps creeping down; reaching the bunkers is an invasion
per_frame_14=basex = 16 + offx;
per_frame_15=basey = 18 + floor((time - wst)*(1 + 0.1*min(wave - 1, 5))/9)*2 + min(wave - 1, 2)*4;
per_frame_16=beat = (bass > 1.3)*((time - last) > 0.35);
per_frame_17=last = if(beat, time, last);
per_frame_18=// cannon: aim at a column that still has aliens, glide there, fire on the beat
per_frame_19=pc = floor(rand(11));
per_frame_20=pc = if((equal(pc, 0)*n0 + equal(pc, 1)*n1 + equal(pc, 2)*n2 + equal(pc, 3)*n3 + equal(pc, 4)*n4 + equal(pc, 5)*n5 + equal(pc, 6)*n6 + equal(pc, 7)*n7 + equal(pc, 8)*n8 + equal(pc, 9)*n9 + equal(pc, 10)*n10) > 0, pc, floor(rand(11)));
per_frame_21=pc = if((equal(pc, 0)*n0 + equal(pc, 1)*n1 + equal(pc, 2)*n2 + equal(pc, 3)*n3 + equal(pc, 4)*n4 + equal(pc, 5)*n5 + equal(pc, 6)*n6 + equal(pc, 7)*n7 + equal(pc, 8)*n8 + equal(pc, 9)*n9 + equal(pc, 10)*n10) > 0, pc, floor(rand(11)));
per_frame_22=pc = if((equal(pc, 0)*n0 + equal(pc, 1)*n1 + equal(pc, 2)*n2 + equal(pc, 3)*n3 + equal(pc, 4)*n4 + equal(pc, 5)*n5 + equal(pc, 6)*n6 + equal(pc, 7)*n7 + equal(pc, 8)*n8 + equal(pc, 9)*n9 + equal(pc, 10)*n10) > 0, pc, floor(rand(11)));
per_frame_23=tx = if((by < 0)*(abs(gx - tx) < 1)*((time - lastfire) > 0.25), basex + pc*16 + 4 + if(tt < 20, 1, -1)*(1.5 + 2.5*min(bass_att, 2))*fast*1.0, tx);
per_frame_24=gx = gx + sign(tx - gx)*min(abs(tx - gx), 110*dt);
per_frame_25=fire = (by < 0)*(abs(gx - tx) < 2)*(beat + ((time - lastfire) > 0.5) > 0)*((time - pt) > 1);
per_frame_26=bx = if(fire, floor(gx), bx);
per_frame_27=by = if(fire, 119, by);
per_frame_28=lastfire = if(fire, time, lastfire);
per_frame_29=by = if(by >= 0, by - 110*dt, by);
per_frame_30=lx = bx - basex;
per_frame_31=ly = by - basey;
