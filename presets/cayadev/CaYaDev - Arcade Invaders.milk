warp_1=`sampler sampler_pw_noise_lq;
warp_2=`float bitAt(float row, float colx, float design, float frameN)
warp_3=`{
warp_4=`  // 8x8 bitmaps, two walking frames per design; each row is a byte packed into a float
warp_5=`  float r = 0.0;
warp_6=`  if (design < 0.5) {
warp_7=`    float4 a = frameN < 0.5 ? float4(24.0, 60.0, 126.0, 219.0) : float4(24.0, 60.0, 126.0, 219.0);
warp_8=`    float4 b = frameN < 0.5 ? float4(255.0, 36.0, 90.0, 165.0) : float4(255.0, 90.0, 129.0, 66.0);
warp_9=`    r = row < 4.0 ? (row < 2.0 ? (row < 1.0 ? a.x : a.y) : (row < 3.0 ? a.z : a.w)) : (row < 6.0 ? (row < 5.0 ? b.x : b.y) : (row < 7.0 ? b.z : b.w));
warp_10=`  } else if (design < 1.5) {
warp_11=`    float4 a = float4(36.0, 126.0, 219.0, 255.0);
warp_12=`    float4 b = frameN < 0.5 ? float4(255.0, 189.0, 36.0, 102.0) : float4(255.0, 189.0, 66.0, 129.0);
warp_13=`    r = row < 4.0 ? (row < 2.0 ? (row < 1.0 ? a.x : a.y) : (row < 3.0 ? a.z : a.w)) : (row < 6.0 ? (row < 5.0 ? b.x : b.y) : (row < 7.0 ? b.z : b.w));
warp_14=`  } else {
warp_15=`    float4 a = float4(60.0, 126.0, 255.0, 219.0);
warp_16=`    float4 b = frameN < 0.5 ? float4(255.0, 102.0, 219.0, 129.0) : float4(255.0, 102.0, 165.0, 66.0);
warp_17=`    r = row < 4.0 ? (row < 2.0 ? (row < 1.0 ? a.x : a.y) : (row < 3.0 ? a.z : a.w)) : (row < 6.0 ? (row < 5.0 ? b.x : b.y) : (row < 7.0 ? b.z : b.w));
warp_18=`  }
warp_19=`  return step(0.5, frac(floor(r / exp2(7.0 - colx)) * 0.5));
warp_20=`}
warp_21=`float maskBit(float w, float k)
warp_22=`{
warp_23=`  // game state arrives as integer bit masks in q vars (22 bits each, exact in float)
warp_24=`  return step(0.5, frac(floor(w / exp2(k)) * 0.5));
warp_25=`}
warp_26=`float digitOf(float v, float base, float i)
warp_27=`{
warp_28=`  float p = pow(base, i);
warp_29=`  return floor(v / p + 0.001) - base * floor(v / (p * base) + 0.001);
warp_30=`}
warp_31=`float glyph(float d, float2 p)
warp_32=`{
warp_33=`  // 3x5 digits, top row in the high bits
warp_34=`  float bits = d < 5.0 ? (d < 2.0 ? (d < 1.0 ? 31599.0 : 9362.0) : (d < 3.0 ? 29671.0 : (d < 4.0 ? 29647.0 : 23497.0)))
warp_35=`                       : (d < 7.0 ? (d < 6.0 ? 31183.0 : 31215.0) : (d < 8.0 ? 29330.0 : (d < 9.0 ? 31727.0 : 31695.0)));
warp_36=`  float inside = step(0.0, p.x) * step(p.x, 2.0) * step(0.0, p.y) * step(p.y, 4.0);
warp_37=`  return inside * maskBit(bits, (4.0 - p.y) * 3.0 + (2.0 - p.x));
warp_38=`}
warp_39=`float burst(float2 d, float age, float size)
warp_40=`{
warp_41=`  // eight-ray pixel explosion that expands and fades
warp_42=`  float r = length(d);
warp_43=`  float ray = step(abs(abs(d.x) - abs(d.y)), 0.5) + step(abs(d.x), 0.5) + step(abs(d.y), 0.5);
warp_44=`  float ring = step(abs(r - age * size), 1.5) + step(r, 2.5 - age * 8.0);
warp_45=`  return min(ray, 1.0) * min(ring, 1.0) * step(age, 0.35);
warp_46=`}
warp_47=`float3 scene(float2 u)
warp_48=`{
warp_49=`  float2 px = floor(u * float2(240.0, 135.0));
warp_50=`  float3 c = float3(0.0, 0.0, 0.0);
warp_51=`  float3 tint = 0.5 + 0.5 * cos(6.28318 * (float3(0.3, 0.45, 0.6) + q4));
warp_52=`  // formation: 11 columns x 5 rows, 16 px apart; position and alive masks come from per_frame
warp_53=`  float2 lp = px - float2(q2, q3);
warp_54=`  float ci = floor(lp.x / 16.0);
warp_55=`  float ri = floor(lp.y / 14.0);
warp_56=`  float2 inCell = float2(lp.x - ci * 16.0, lp.y - ri * 14.0);
warp_57=`  if (ci >= 0.0 && ci < 11.0 && ri >= 0.0 && ri < 5.0 && inCell.x < 8.0 && inCell.y < 8.0) {
warp_58=`    float k = ri * 11.0 + ci;
warp_59=`    float wi = floor(k / 22.0);
warp_60=`    float alive = maskBit(wi < 0.5 ? q6 : (wi < 1.5 ? q7 : q8), k - wi * 22.0);
warp_61=`    float design = ri < 1.0 ? 0.0 : (ri < 3.0 ? 1.0 : 2.0);
warp_62=`    float on = bitAt(inCell.y, inCell.x, design, frac(q1 * 0.5) < 0.5 ? 0.0 : 1.0);
warp_63=`    float3 ic = ri < 1.0 ? float3(1.0, 0.35, 0.8) : (ri < 3.0 ? float3(0.4, 0.9, 1.0) : float3(0.5, 1.0, 0.4));
warp_64=`    c = on * alive * ic;
warp_65=`  }
warp_66=`  // shields: 11x2 cells of 2x5 px each; every hit clears one cell
warp_67=`  float sx = px.x - 26.0;
warp_68=`  float sk = floor(sx / 52.0);
warp_69=`  float sl = sx - sk * 52.0;
warp_70=`  if (sk >= 0.0 && sk < 4.0 && sl < 22.0 && px.y >= 104.0 && px.y < 114.0) {
warp_71=`    float sw = sk < 0.5 ? q9 : (sk < 1.5 ? q10 : (sk < 2.5 ? q11 : q12));
warp_72=`    float cell = floor((px.y - 104.0) / 5.0) * 11.0 + floor(sl / 2.0);
warp_73=`    float corner = step(sl, 0.5) * step(px.y, 104.5) + step(20.5, sl) * step(px.y, 104.5);
warp_74=`    c = float3(0.3, 1.0, 0.35) * maskBit(sw, cell) * (1.0 - corner);
warp_75=`  }
warp_76=`  // mystery saucer
warp_77=`  float2 up = px - float2(floor(q25), 8.0);
warp_78=`  float saucer = step(abs(up.y), 2.0) * step(abs(up.x), 6.0 - max(-up.y, 0.0) * 2.0 - max(up.y - 1.0, 0.0) * 3.0);
warp_79=`  saucer *= 1.0 - step(abs(up.y), 0.5) * step(0.5, frac((up.x + floor(time * 12.0)) * 0.25 + 0.25)) * 0.6;
warp_80=`  c = max(c, float3(1.0, 0.25, 0.3) * saucer * step(-20.0, q25));
warp_81=`  // cannon; blinks red after a bomb hit
warp_82=`  float2 cp = px - float2(floor(q13), 124.0);
warp_83=`  float cannon = step(abs(cp.x), 6.0) * step(0.0, cp.y) * step(cp.y, 4.0) + step(abs(cp.x), 1.0) * step(-2.0, cp.y) * step(cp.y, 0.0);
warp_84=`  float hurt = step(q24, 1.0);
warp_85=`  cannon *= 1.0 - hurt * step(0.5, frac(time * 8.0));
warp_86=`  c = max(c, lerp(float3(0.4, 1.0, 0.5), float3(1.0, 0.3, 0.2), hurt) * cannon);
warp_87=`  c = max(c, float3(1.0, 0.5, 0.2) * burst(px - float2(floor(q13), 125.0), q24, 40.0));
warp_88=`  // player shot
warp_89=`  float shot = step(abs(px.x - q14), 0.5) * step(q15 - 3.0, px.y) * step(px.y, q15) * step(0.0, q15);
warp_90=`  c = max(c, float3(1.0, 1.0, 0.8) * shot);
warp_91=`  // alien bomb: a zigzag falling bolt
warp_92=`  float zig = step(0.5, frac((px.y + floor(time * 20.0)) * 0.25));
warp_93=`  float bomb = step(abs(px.x - q16 - zig), 0.5) * step(q17 - 4.0, px.y) * step(px.y, q17) * step(0.0, q17);
warp_94=`  c = max(c, float3(1.0, 0.85, 0.4) * bomb);
warp_95=`  // explosions: alien or saucer, then small bunker chips
warp_96=`  c = max(c, lerp(float3(1.0, 1.0, 1.0), float3(1.0, 0.5, 0.1), saturate(q20 * 4.0)) * burst(px - floor(float2(q18, q19)), q20, 30.0));
warp_97=`  float2 hd = px - floor(float2(q21, q22));
warp_98=`  c = max(c, float3(0.7, 1.0, 0.6) * step(abs(hd.x) + abs(hd.y), 2.0) * step(q23, 0.12));
warp_99=`  float ground = step(abs(px.y - 130.0), 0.5);
warp_100=`  c = max(c, float3(0.3, 1.0, 0.35) * ground * 0.8);
warp_101=`  // score top left, wave pips top right
warp_102=`  float sc = q27 - 10000.0 * floor(q27 / 10000.0);
warp_103=`  float2 sp = px - float2(4.0, 3.0);
warp_104=`  float di = floor(sp.x / 4.0);
warp_105=`  float digit = (di >= 0.0 && di < 4.0) ? glyph(digitOf(sc, 10.0, 3.0 - di), float2(sp.x - di * 4.0, sp.y)) : 0.0;
warp_106=`  c = max(c, lerp(float3(0.9, 0.9, 0.9), float3(1.0, 1.0, 0.4), step(q20, 0.15)) * digit);
warp_107=`  float2 wp = px - float2(232.0, 3.0);
warp_108=`  float wi = floor(-wp.x / 4.0);
warp_109=`  float pip = step(0.0, wi) * step(wi, min(q28, 9.0) - 1.0) * step(-wp.x - wi * 4.0, 1.5) * step(0.0, wp.y) * step(wp.y, 2.0) * step(wp.x, 0.5);
warp_110=`  c = max(c, float3(1.0, 0.4, 0.8) * pip);
warp_111=`  // invaded: red alarm
warp_112=`  c = lerp(c, float3(1.0, 0.1, 0.1) * (0.4 + 0.6 * step(0.5, frac(q29 * 4.0))), saturate(1.0 - q29 / 1.5) * 0.6 * step(0.0, q29));
warp_113=`  // a new wave arrives with a short flash
warp_114=`  c += float3(0.15, 0.3, 0.35) * step(q26, 0.4) * (1.0 - q26 * 2.5);
warp_115=`  return c * lerp(float3(1.0, 1.0, 1.0), tint, 0.25);
warp_116=`}
warp_117=`shader_body
warp_118=`{
warp_119=`  // the scene is drawn here so the phosphor afterimage and glow can come from the buffer
warp_120=`  float2 g = floor(uv * float2(320.0, 180.0));
warp_121=`  float4 n = tex2D(sampler_pw_noise_lq, g / 256.0);
warp_122=`  float star = step(0.995, n.x) * (0.5 + 0.5 * sin(time * (1.0 + n.y * 3.0) + n.z * 6.28)) * (0.6 + 0.3 * q5);
warp_123=`  float3 old = tex2D(sampler_main, uv).xyz;
warp_124=`  ret = max(old * pow(0.6, q30) - 0.002 * max(q30, 1.0), max(scene(uv), float3(star, star, star) * 0.8));
warp_125=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 cc = uv - 0.5;
comp_4=`  float2 u = 0.5 + cc * (1.0 + dot(cc, cc) * 0.08);
comp_5=`  float inside = step(0.0, u.x) * step(u.x, 1.0) * step(0.0, u.y) * step(u.y, 1.0);
comp_6=`  float3 col = tex2D(sampler_main, u).xyz;
comp_7=`  col += GetBlur1(u) * 0.45 + GetBlur2(u) * 0.2;
comp_8=`  float scan = 0.75 + 0.25 * sin(u.y * 135.0 * 6.28318);
comp_9=`  col *= scan;
comp_10=`  col += float3(0.01, 0.015, 0.02);
comp_11=`  col *= inside * (1.0 - dot(cc, cc) * 1.1);
comp_12=`  ret = 1.0 - exp(-col * 1.6);
comp_13=`}
