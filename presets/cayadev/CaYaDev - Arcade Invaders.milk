per_frame_49=n6 = n6 - kil*equal(ac, 6);
per_frame_50=n7 = n7 - kil*equal(ac, 7);
per_frame_51=n8 = n8 - kil*equal(ac, 8);
per_frame_52=n9 = n9 - kil*equal(ac, 9);
per_frame_53=n10 = n10 - kil*equal(ac, 10);
per_frame_54=alive = alive - kil;
per_frame_55=score = score + kil*if(ar < 1, 30, if(ar < 3, 20, 10));
per_frame_56=ex = if(kil, basex + ac*16 + 4, ex);
per_frame_57=ey = if(kil, basey + ar*14 + 4, ey);
per_frame_58=et = if(kil, time, et);
per_frame_59=by = if(kil, -1, by);
per_frame_60=gl = bx - 26;
per_frame_61=gk = floor(gl/52);
per_frame_62=gs = gl - gk*52;
per_frame_63=gon = (by >= 0)*(gk >= 0)*(gk < 4)*(gs < 22)*(by >= 104)*(by < 114);
per_frame_64=gp = pow(2, floor((by - 104)/5)*11 + floor(gs/2));
per_frame_65=gv = if(equal(gk, 0), s0, if(equal(gk, 1), s1, if(equal(gk, 2), s2, s3)));
per_frame_66=gh = gon*(floor(gv/gp) - 2*floor(gv/(2*gp)));
