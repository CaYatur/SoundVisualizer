per_frame_117=gon = (by >= 0)*(gk >= 0)*(gk < 4)*(gs < 22)*(by >= 104)*(by < 114);
per_frame_118=gp = pow(2, floor((by - 104)/5)*11 + floor(gs/2));
per_frame_119=gv = if(equal(gk, 0), s0, if(equal(gk, 1), s1, if(equal(gk, 2), s2, s3)));
per_frame_120=gh = gon*(floor(gv/gp) - 2*floor(gv/(2*gp)));
per_frame_121=s0 = s0 - gh*equal(gk, 0)*gp;
per_frame_122=s1 = s1 - gh*equal(gk, 1)*gp;
