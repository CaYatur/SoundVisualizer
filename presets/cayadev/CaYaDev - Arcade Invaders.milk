per_frame_init_5=n0 = 5; n1 = 5; n2 = 5; n3 = 5; n4 = 5; n5 = 5; n6 = 5; n7 = 5; n8 = 5; n9 = 5; n10 = 5;
per_frame_init_6=gx = 120;
