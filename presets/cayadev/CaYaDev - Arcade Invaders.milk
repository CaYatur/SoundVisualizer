per_frame_33=ar = floor(ly/14);
per_frame_34=ain = (by >= 0)*(ac >= 0)*(ac < 11)*(ar >= 0)*(ar < 5)*(lx - ac*16 < 8)*(ly - ar*14 < 8);
per_frame_35=bw = floor((ar*11 + ac)/22);
per_frame_36=bp = pow(2, (ar*11 + ac) - bw*22);
per_frame_37=bv = if(equal(bw, 0), w0, if(equal(bw, 1), w1, w2));
per_frame_38=ba = floor(bv/bp) - 2*floor(bv/(2*bp));
