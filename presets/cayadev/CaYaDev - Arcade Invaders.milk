per_frame_160=r0p = pow(2, (0*11 + bc) - r0w*22);
per_frame_161=r0v = if(equal(r0w, 0), w0, if(equal(r0w, 1), w1, w2));
per_frame_162=r0a = floor(r0v/r0p) - 2*floor(r0v/(2*r0p));
per_frame_163=br = if(r4a, 4, if(r3a, 3, if(r2a, 2, if(r1a, 1, if(r0a, 0, -1)))));
per_frame_164=drp = drp*(br >= 0);
per_frame_165=mx = if(drp, floor(basex + bc*16 + 4), mx);
per_frame_166=my = if(drp, basey + br*14 + 8, my);
per_frame_167=nb = if(drp, time + (0.9 + rand(100)*0.016)/(1 + 0.12*wave), nb);
per_frame_168=my = if(my >= 0, my + 36*dt, my);
per_frame_169=ml = mx - 26;
per_frame_170=mk = floor(ml/52);
per_frame_171=ms = ml - mk*52;
per_frame_172=mon = (my >= 0)*(mk >= 0)*(mk < 4)*(ms < 22)*(my >= 104)*(my < 114);
per_frame_173=mp = pow(2, floor((my - 104)/5)*11 + floor(ms/2));
