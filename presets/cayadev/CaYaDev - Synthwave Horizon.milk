MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
wavecode_0_enabled=1
wavecode_0_samples=320
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=0
wavecode_0_bAdditive=1
wavecode_0_scaling=1
wavecode_0_smoothing=0.6
wavecode_0_r=1
wavecode_0_g=1
wavecode_0_b=1
wavecode_0_a=0.8
wave_0_per_frame1=a = 0.8*min(1, q30);
wave_0_per_point1=x = sample;
wave_0_per_point2=y = 1 - 0.585 + value1*0.06*sin(sample*3.14159);
wave_0_per_point3=r = 0.2;
wave_0_per_point4=g = 0.9;
wave_0_per_point5=b = 1;
per_frame_init_1=travel = 0;
per_frame_init_2=last = 0;
per_frame_init_3=glow = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=travel = travel + (0.8 + 1.4*bass_att)/fps;
per_frame_5=beat = (bass > 1.25)*((time - last) > 0.25);
per_frame_6=last = if(beat, time, last);
per_frame_7=glow = max(glow*pow(0.9, q30), beat);
per_frame_8=q1 = travel;
per_frame_9=q2 = glow;
per_frame_10=q3 = time*0.05 + mid_att*0.02;
per_frame_11=q4 = treb_att;
per_frame_12=q5 = 0.5 + 0.5*bass_att;
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = tex2D(sampler_main, uv).xyz * pow(0.8, q30);
warp_4=`  ret = max(ret - 0.004 * q30, 0.0);
warp_5=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`shader_body
comp_3=`{
comp_4=`  float hor = 0.585;
comp_5=`  float2 p = (uv - float2(0.5, hor)) * aspect.xy;
comp_6=`  float3 col;
comp_7=`  if (uv.y < hor) {
comp_8=`    float h = (hor - uv.y) / hor;
comp_9=`    col = lerp(float3(0.55, 0.08, 0.45), float3(0.04, 0.01, 0.12), saturate(h * 1.4));
comp_10=`    float2 sc = p - float2(0.0, -0.17);
comp_11=`    float sr = length(sc);
comp_12=`    float sun = saturate((0.165 - sr) * 300.0);
comp_13=`    float sy = (sc.y + 0.165) / 0.33;
comp_14=`    float cut = step(frac(sy * 9.0 + q3), lerp(1.0, 0.45, saturate((sy - 0.45) * 2.0)));
comp_15=`    cut = lerp(1.0, cut, step(0.45, sy));
comp_16=`    float3 suncol = lerp(float3(1.0, 0.25, 0.55), float3(1.0, 0.85, 0.25), saturate(1.0 - sy));
comp_17=`    col = lerp(col, suncol, sun * cut);
comp_18=`    col += float3(1.0, 0.3, 0.5) * exp(-max(sr - 0.165, 0.0) * 14.0) * 0.35;
comp_19=`    float m1 = tex2D(sampler_noise_hq, float2(uv.x * 1.7, 0.31)).x;
comp_20=`    float m2 = tex2D(sampler_noise_hq, float2(uv.x * 5.3, 0.77)).x;
comp_21=`    float ridge = hor - 0.03 - 0.12 * m1 * m1 - 0.012 * m2;
comp_22=`    float mtn = saturate((uv.y - ridge) * 500.0);
comp_23=`    float edge = exp(-abs(uv.y - ridge) * 900.0);
comp_24=`    float3 rock = float3(0.03, 0.0, 0.07) + float3(0.0, 0.3, 0.5) * saturate(1.0 - (uv.y - ridge) * 30.0) * 0.4;
comp_25=`    col = lerp(col, rock, mtn);
comp_26=`    col += float3(0.2, 0.9, 1.0) * edge * 0.9;
comp_27=`    float2 sp = uv * texsize.xy / 512.0;
comp_28=`    float4 st = tex2D(sampler_pw_noise_lq, sp);
comp_29=`    float star = saturate((st.x * st.y - 0.975) * 45.0) * (0.5 + 0.5 * sin(time * 2.0 + st.z * 30.0)) * (1.0 - mtn) * saturate(h * 2.0 - 0.3);
comp_30=`    col += star * (0.6 + 0.5 * q4);
comp_31=`  } else {
comp_32=`    float dz = uv.y - hor;
comp_33=`    float z = 0.12 / (dz + 0.004);
comp_34=`    float wx = (uv.x - 0.5) * aspect.x * z * 9.0;
comp_35=`    float wz = z * 5.0 + q1 * 2.0;
comp_36=`    float aa = 0.04 * z;
comp_37=`    float lx = saturate(1.0 - abs(frac(wx) - 0.5) / (0.03 + aa));
comp_38=`    float lz = saturate(1.0 - abs(frac(wz) - 0.5) / (0.03 + aa));
comp_39=`    float fog = saturate(dz * 6.0);
comp_40=`    float3 neon = lerp(float3(1.0, 0.2, 0.8), float3(0.2, 0.8, 1.0), saturate(abs(uv.x - 0.5) * 2.5));
comp_41=`    col = float3(0.03, 0.0, 0.07) + neon * max(lx, lz) * fog * (0.8 + 0.9 * q2);
comp_42=`    col += float3(1.0, 0.4, 0.5) * exp(-abs(uv.x - 0.5) * 12.0) * exp(-dz * 10.0) * 0.4;
comp_43=`    col += float3(0.5, 0.1, 0.5) * exp(-dz * 40.0) * 0.8;
comp_44=`  }
comp_45=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_46=`  col += m * float3(0.6, 0.9, 1.0) + GetBlur1(uv) * 0.8 + GetBlur2(uv) * float3(0.9, 0.5, 1.0) * 0.6;
comp_47=`  float2 v = uv - 0.5;
comp_48=`  col *= 1.0 - dot(v, v) * 0.5;
comp_49=`  ret = 1.0 - exp(-col * 1.5);
comp_50=`}
