per_frame_init_8=an_3 = -1.5;
per_frame_init_9=ln_3 = 0.1;
per_frame_init_10=an_4 = -1.5;
per_frame_init_11=ln_4 = 0.1;
per_frame_init_12=an_5 = -1.5;
per_frame_init_13=ln_5 = 0.1;
per_frame_init_14=an_6 = -1.5;
per_frame_init_15=ln_6 = 0.1;
per_frame_init_16=an_7 = -1.5;
per_frame_init_17=ln_7 = 0.1;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.3)*((time - last) > 0.25);
per_frame_5=last = if(beat, time, last);
per_frame_6=hit = max(hit*pow(0.75, q30), beat);
per_frame_7=tk = floor(time*12);
per_frame_8=nw = (abs(tk - ptk) > 0.5);
per_frame_9=ptk = tk;
per_frame_10=q5 = hit;
per_frame_11=q12 = min(0.25 + 0.6*treb_att, 1.2);
per_frame_12=q14 = min(bass_att, 2);
per_frame_13=an_1 = if(nw, -0.3 - 2.54*(rand(1000)*0.001), an_1);
per_frame_14=ln_1 = if(nw, 0.06 + 0.16*(rand(1000)*0.001)*(0.6 + 0.4*min(treb_att, 1.5)), ln_1);
per_frame_15=q6 = an_1;
per_frame_16=q7 = ln_1;
per_frame_17=an_2 = if(nw, -0.3 - 2.54*(rand(1000)*0.001), an_2);
per_frame_18=ln_2 = if(nw, 0.06 + 0.16*(rand(1000)*0.001)*(0.6 + 0.4*min(treb_att, 1.5)), ln_2);
per_frame_19=q8 = an_2;
per_frame_20=q9 = ln_2;
per_frame_21=an_3 = if(nw, -0.3 - 2.54*(rand(1000)*0.001), an_3);
per_frame_22=ln_3 = if(nw, 0.06 + 0.16*(rand(1000)*0.001)*(0.6 + 0.4*min(treb_att, 1.5)), ln_3);
per_frame_23=q10 = an_3;
per_frame_24=q11 = ln_3;
per_frame_25=an_4 = if(nw, -0.3 - 2.54*(rand(1000)*0.001), an_4);
per_frame_26=ln_4 = if(nw, 0.06 + 0.16*(rand(1000)*0.001)*(0.6 + 0.4*min(treb_att, 1.5)), ln_4);
per_frame_27=q1 = an_4;
per_frame_28=q2 = ln_4;
per_frame_29=an_5 = if(nw, -0.3 - 2.54*(rand(1000)*0.001), an_5);
per_frame_30=ln_5 = if(nw, 0.06 + 0.16*(rand(1000)*0.001)*(0.6 + 0.4*min(treb_att, 1.5)), ln_5);
per_frame_31=q3 = an_5;
per_frame_32=q4 = ln_5;
per_frame_33=an_6 = if(nw, -0.3 - 2.54*(rand(1000)*0.001), an_6);
per_frame_34=ln_6 = if(nw, 0.06 + 0.16*(rand(1000)*0.001)*(0.6 + 0.4*min(treb_att, 1.5)), ln_6);
per_frame_35=q13 = an_6;
per_frame_36=q15 = ln_6;
per_frame_37=an_7 = if(nw, -0.3 - 2.54*(rand(1000)*0.001), an_7);
per_frame_38=ln_7 = if(nw, 0.06 + 0.16*(rand(1000)*0.001)*(0.6 + 0.4*min(treb_att, 1.5)), ln_7);
per_frame_39=q16 = an_7;
per_frame_40=q17 = ln_7;
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = max(tex2D(sampler_main, uv).xyz * pow(0.5, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 p = (uv - 0.5) * aspect.xy;
comp_4=`  float px = 1.0 / texsize.x;
comp_5=`  float3 bolt = tex2D(sampler_main, uv).xyz;
comp_6=`  float3 b1 = GetBlur1(uv);
comp_7=`  float3 b2 = GetBlur2(uv);
comp_8=`  float3 b3 = GetBlur3(uv);
comp_9=`  float3 glow = b3 * float3(0.55, 0.4, 1.0);
comp_10=`  float light = lum(GetBlur3(float2(0.5, 0.45))) * 2.5 + q5 * 0.3;
comp_11=`  float floorY = 0.25;
comp_12=`  float3 col = lerp(float3(0.015, 0.012, 0.03), float3(0.03, 0.025, 0.05), uv.y);
comp_13=`  col += glow * 0.9 + light * float3(0.06, 0.05, 0.12) * (1.0 - length(p));
comp_14=`  float fl = step(floorY, p.y);
comp_15=`  float2 mu = float2(uv.x, (0.5 + floorY / aspect.y) * 2.0 - uv.y);
comp_16=`  float3 refl = (tex2D(sampler_main, mu).xyz * 0.25 + GetBlur2(mu) * 0.6) * float3(0.6, 0.5, 1.0);
comp_17=`  float3 flc = float3(0.02, 0.02, 0.03) + refl * exp(-(p.y - floorY) * 6.0) + glow * 0.3;
comp_18=`  flc += float3(0.03, 0.03, 0.05) * step(0.97, frac((p.x + 0.5) * 12.0 + (p.y - floorY) * 4.0));
comp_19=`  col = lerp(col, flc, fl);
comp_20=`  float2 tq = p - float2(-0.18, -0.07);
comp_21=`  float cw = 0.022;
comp_22=`  float col1 = step(abs(tq.x), cw) * step(0.0, tq.y) * step(p.y, floorY);
comp_23=`  float wind = 0.6 + 0.4 * step(0.5, frac(tq.y * 260.0));
comp_24=`  float3 copper = float3(0.7, 0.38, 0.18) * wind * (0.35 + 0.65 * cos(tq.x / cw * 1.4)) * (0.25 + light * 0.6);
comp_25=`  col = lerp(col, copper, col1);
comp_26=`  float base = step(abs(tq.x), 0.05) * step(abs(p.y - floorY + 0.015), 0.015);
comp_27=`  col = lerp(col, float3(0.1, 0.1, 0.12) * (0.5 + light), base);
comp_28=`  float2 te = tq / float2(0.068, 0.03);
comp_29=`  float tr = length(te);
comp_30=`  float tor = 1.0 - smoothstep(1.0 - px * 30.0, 1.0, tr);
comp_31=`  float3 tn = normalize(float3(te.x * 0.8, te.y, sqrt(saturate(1.0 - tr * tr)) + 0.2));
comp_32=`  float sp = pow(saturate(dot(reflect(float3(0.0, 0.0, -1.0), tn), normalize(float3(0.3, -0.6, 0.7)))), 20.0);
comp_33=`  float3 alu = float3(0.55, 0.57, 0.62) * (0.2 + 0.5 * saturate(-tn.y + 0.4)) * (0.4 + light) + sp * (0.3 + light) + glow * 0.4;
comp_34=`  col = lerp(col, alu, tor);
comp_35=`  float2 sq = p - float2(0.22, 0.03);
comp_36=`  float stand = step(abs(sq.x), 0.006) * step(0.0, sq.y) * step(p.y, floorY);
comp_37=`  col = lerp(col, float3(0.12, 0.12, 0.14) * (0.5 + light), stand);
comp_38=`  float sr = length(sq) / 0.042;
comp_39=`  float sph = 1.0 - smoothstep(1.0 - px * 24.0, 1.0, sr);
comp_40=`  float3 sn = normalize(float3(sq / 0.042, sqrt(saturate(1.0 - sr * sr))));
comp_41=`  float ssp = pow(saturate(dot(reflect(float3(0.0, 0.0, -1.0), sn), normalize(float3(-0.6, -0.5, 0.6)))), 30.0);
comp_42=`  float3 ball = float3(0.6, 0.6, 0.66) * (0.15 + 0.6 * saturate(dot(sn, normalize(float3(-0.7, -0.4, 0.6))))) * (0.4 + light) + ssp * (0.4 + light) + glow * 0.5;
comp_43=`  col = lerp(col, ball, sph);
comp_44=`  col += bolt * float3(0.9, 0.85, 1.0) * 1.4 + b1 * float3(0.6, 0.45, 1.0) * 1.1 + b2 * float3(0.4, 0.3, 1.0) * 0.6;
comp_45=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_46=`  ret = 1.0 - exp(-col * 1.5);
comp_47=`}
