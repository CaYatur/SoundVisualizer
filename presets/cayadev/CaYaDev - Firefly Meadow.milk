per_frame_init_1=last = 0;
per_frame_init_2=flash = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.35)*((time - last) > 0.8);
per_frame_5=last = if(beat, time, last);
per_frame_6=flash = max(flash*pow(0.88, q30), beat);
per_frame_7=q1 = time*0.004;
per_frame_8=q2 = min(treb_att, 2);
per_frame_9=q3 = flash;
per_frame_10=q4 = min(bass_att, 2);
per_frame_11=q5 = time*0.90;
per_frame_12=q7 = 0;
per_frame_13=q8 = time*1.02;
per_frame_14=q11 = time*1.14;
per_frame_15=q14 = time*1.26;
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = max(tex2D(sampler_main, uv).xyz * pow(0.8, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_4=`}
comp_1=`float grass(float2 u, float scale, float h0, float seed)
comp_2=`{
comp_3=`  float x = u.x * scale;
comp_4=`  float c = floor(x);
comp_5=`  float f = frac(x) - 0.5;
comp_6=`  float4 n = tex2D(sampler_noise_lq, (floor((float2((c + seed) / 256.0, seed / 256.0)) * 256.0) + 0.5) / 256.0);
comp_7=`  float hgt = h0 + 0.12 * n.x;
comp_8=`  float lean = (n.y - 0.5) * 0.6 + 0.08 * sin(time * 0.6 + c);
comp_9=`  float top = 1.0 - hgt;
comp_10=`  float t = saturate((u.y - top) / hgt);
comp_11=`  float w = 0.22 * (0.6 + 0.4 * n.z) * t;
comp_12=`  float blade = step(abs(f - lean * (1.0 - t)), w * (0.25 + t)) * step(top, u.y);
comp_13=`  return blade;
comp_14=`}
comp_15=`shader_body
comp_16=`{
comp_17=`  float3 sky = lerp(float3(0.16, 0.12, 0.28), float3(0.02, 0.02, 0.07), saturate(1.0 - uv.y * 1.5));
comp_18=`  sky += float3(0.35, 0.18, 0.12) * exp(-abs(uv.y - 0.62) * 9.0) * 0.5;
comp_19=`  float4 st = tex2D(sampler_noise_lq, (floor((uv * texsize.xy / 512.0) * 256.0) + 0.5) / 256.0);
comp_20=`  sky += saturate((st.x * st.y - 0.982) * 50.0) * step(uv.y, 0.45) * (0.5 + 0.5 * sin(time * 1.7 + st.z * 20.0));
comp_21=`  float crown = tex3D(sampler_noisevol_hq, float3(uv.x * 1.6, 0.2, 0.3)).x * 0.06 + tex3D(sampler_noisevol_hq, float3(uv.x * 7.0, 0.6, 0.1)).x * 0.025;
comp_22=`  float tree = smoothstep(0.6 - crown - 0.002, 0.6 - crown + 0.002, uv.y);
comp_23=`  float3 col = lerp(sky, float3(0.015, 0.02, 0.03), tree);
comp_24=`  float3 fly = tex2D(sampler_main, uv).xyz;
comp_25=`  float3 halo = GetBlur1(uv) * 1.2 + GetBlur2(uv) * 0.9 + GetBlur3(uv) * 0.6;
comp_26=`  float mist = exp(-abs(uv.y - 0.7) * 7.0) * (0.5 + 0.5 * tex3D(sampler_noisevol_hq, float3(uv * float2(2.0, 0.8), q1)).x);
comp_27=`  col += float3(0.25, 0.3, 0.35) * mist * 0.18 + halo * float3(0.7, 0.9, 0.35) * (0.5 + mist);
comp_28=`  col += fly * 1.4;
comp_29=`  float g1 = grass(uv, 70.0, 0.22, 3.0);
comp_30=`  float g2 = grass(uv + float2(0.37, 0.0), 120.0, 0.14, 11.0);
comp_31=`  col = lerp(col, float3(0.01, 0.015, 0.012) + halo * 0.15, g1);
comp_32=`  col = lerp(col, float3(0.005, 0.008, 0.006), g2);
comp_33=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_34=`  ret = 1.0 - exp(-col * 1.5);
comp_35=`}
