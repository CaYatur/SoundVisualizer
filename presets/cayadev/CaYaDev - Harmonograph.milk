per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.4)*((time - last) > 20);
per_frame_5=go = ((beat + ((time - last) > 45)) > 0);
per_frame_6=last = if(go, time, last);
per_frame_7=age = time - last;
per_frame_8=tk = floor(time*4);
per_frame_9=tick = (abs(tk - ptk) > 0.5);
per_frame_10=ptk = tk;
per_frame_11=q4 = tick*0.004 + go;
per_frame_12=det = det + (0.002 + 0.01*mid_att)/fps;
per_frame_13=q1 = age;
per_frame_14=q2 = min(bass_att, 2);
per_frame_15=q3 = time*0.01;
per_frame_16=q5 = age*1.50;
